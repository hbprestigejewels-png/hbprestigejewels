{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .judgeme-product-reviews-wrapper {
    max-width: 1240px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .judgeme-section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .judgeme-section-header .subheading {
    display: inline-block;
    font-size: 1.2rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #c9a15a;
    margin-bottom: 0.8rem;
  }

  .judgeme-section-header .heading {
    font-size: 3rem;
    line-height: 1.2;
    margin: 0 0 1.2rem;
    font-family: var(--font-heading-family);
    color: #1a1a1a;
  }

  /* Summary Card */
  .p-reviews-summary-card {
    background: #fff;
    border: 1px solid #ebdccb;
    border-radius: 18px;
    padding: 2.5rem 3rem;
    margin-bottom: 3rem;
    display: grid;
    grid-template-columns: 240px 1fr 220px;
    align-items: center;
    gap: 3rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  @media screen and (max-width: 989px) {
    .p-reviews-summary-card {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2rem;
      padding: 2rem;
    }
  }

  .p-reviews-score-box {
    text-align: center;
    border-right: 1px solid #f0e6d8;
    padding-right: 2rem;
  }

  @media screen and (max-width: 989px) {
    .p-reviews-score-box {
      border-right: none;
      padding-right: 0;
      border-bottom: 1px solid #f0e6d8;
      padding-bottom: 1.5rem;
    }
  }

  .p-reviews-big-score {
    font-size: 4.6rem;
    font-weight: 700;
    line-height: 1;
    color: #1a1a1a;
    margin-bottom: 0.6rem;
  }

  .p-reviews-big-stars {
    color: #c9a15a;
    font-size: 2rem;
    letter-spacing: 3px;
    margin-bottom: 0.5rem;
  }

  .p-reviews-total-count {
    font-size: 1.3rem;
    color: #666;
  }

  .p-reviews-bars {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .p-reviews-bar-row {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    font-size: 1.25rem;
    color: #555;
  }

  .p-reviews-bar-row .bar-label {
    width: 55px;
    white-space: nowrap;
  }

  .p-reviews-bar-track {
    flex-grow: 1;
    height: 8px;
    background: #f0ebe2;
    border-radius: 10px;
    overflow: hidden;
  }

  .p-reviews-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #c9a15a, #e2c185);
    border-radius: 10px;
  }

  .p-reviews-bar-count {
    width: 40px;
    text-align: right;
    font-size: 1.2rem;
    color: #888;
  }

  .p-reviews-action-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .p-reviews-write-btn {
    background: #1a1a1a;
    color: #fff;
    border: none;
    border-radius: 30px;
    padding: 1.2rem 2.8rem;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .p-reviews-write-btn:hover {
    background: #c9a15a;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(201, 161, 90, 0.28);
  }

  /* Carousel / Slider Container */
  .p-reviews-slider-wrapper {
    position: relative;
    margin: 1rem 0 3rem;
  }

  .p-reviews-track {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 1rem 0.5rem 2rem;
    scrollbar-width: none;
  }

  .p-reviews-track::-webkit-scrollbar {
    display: none;
  }

  .p-review-card {
    flex: 0 0 calc((100% - 4rem) / 3);
    min-width: 320px;
    scroll-snap-align: start;
    background: #ffffff;
    border: 1px solid #ebdccb;
    border-radius: 18px;
    padding: 2.5rem 2.2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
  }

  @media screen and (max-width: 989px) {
    .p-review-card {
      flex: 0 0 calc((100% - 2rem) / 2);
      min-width: 280px;
    }
  }

  @media screen and (max-width: 640px) {
    .p-review-card {
      flex: 0 0 85%;
      min-width: 260px;
    }
  }

  .p-review-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(201, 161, 90, 0.15);
    border-color: #c9a15a;
  }

  .p-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
  }

  .p-card-stars {
    color: #c9a15a;
    font-size: 1.6rem;
    letter-spacing: 2px;
  }

  .p-card-date {
    font-size: 1.2rem;
    color: #999;
  }

  .p-card-title {
    font-size: 1.65rem;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 0.8rem;
    line-height: 1.35;
  }

  .p-card-text {
    font-size: 1.35rem;
    color: #4a4a4a;
    line-height: 1.65;
    margin: 0 0 1.8rem;
    flex-grow: 1;
  }

  .p-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #f3ebe1;
    padding-top: 1.2rem;
  }

  .p-card-author {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .p-card-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fdf5ea;
    border: 1px solid #e8d7c0;
    color: #9e7b39;
    font-weight: 700;
    font-size: 1.3rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .p-card-author-name {
    font-size: 1.35rem;
    font-weight: 600;
    color: #222;
  }

  .p-card-verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 1.15rem;
    color: #2e7d32;
    font-weight: 500;
  }

  .p-card-verified svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  /* Slider Controls */
  .p-slider-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid #ebdccb;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    transition: all 0.25s ease;
    color: #1a1a1a;
  }

  .p-slider-nav-btn:hover {
    background: #1a1a1a;
    color: #fff;
    border-color: #1a1a1a;
    transform: translateY(-50%) scale(1.06);
  }

  .p-slider-nav-btn.prev {
    left: -20px;
  }

  .p-slider-nav-btn.next {
    right: -20px;
  }

  @media screen and (max-width: 749px) {
    .p-slider-nav-btn.prev { left: 4px; }
    .p-slider-nav-btn.next { right: 4px; }
  }

  .p-slider-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 1rem;
  }

  .p-slider-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #dcd4c7;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .p-slider-dot.active {
    width: 24px;
    border-radius: 10px;
    background: #c9a15a;
  }

  /* Modal Form */
  .p-review-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .p-review-modal-box {
    background: #fff;
    border-radius: 20px;
    max-width: 540px;
    width: 100%;
    padding: 3rem;
    position: relative;
    box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    max-height: 90vh;
    overflow-y: auto;
  }

  .p-modal-close-btn {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: transparent;
    border: none;
    font-size: 2.4rem;
    cursor: pointer;
    color: #888;
    line-height: 1;
  }

  .p-modal-close-btn:hover {
    color: #111;
  }

  .p-star-select {
    display: flex;
    gap: 6px;
    margin: 1rem 0 1.5rem;
    cursor: pointer;
  }

  .p-star-select span {
    font-size: 2.6rem;
    color: #ccc;
    transition: color 0.2s ease;
  }

  .p-star-select span.selected,
  .p-star-select span.hovered {
    color: #c9a15a;
  }

  .p-form-group {
    margin-bottom: 1.4rem;
    text-align: left;
  }

  .p-form-group label {
    display: block;
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #222;
  }

  .p-form-group input,
  .p-form-group textarea {
    width: 100%;
    padding: 1.1rem 1.4rem;
    border: 1px solid #dcd4c7;
    border-radius: 8px;
    font-size: 1.35rem;
    font-family: inherit;
    box-sizing: border-box;
  }

  .p-form-group input:focus,
  .p-form-group textarea:focus {
    outline: none;
    border-color: #c9a15a;
    box-shadow: 0 0 0 3px rgba(201, 161, 90, 0.15);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
