<link rel="stylesheet" href="{{ 'component-deferred-media.css' | asset_url }}" media="print" onload="this.media='all'">

<style>
      /* ========== SHOP BY SHAPE SECTION STYLES ========== */
      .shop-by-shape {
        background-color: {{ section.settings.background_color }};
        padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
        overflow-x: hidden;
      }

      @media screen and (max-width: 749px) {
        .shop-by-shape {
          padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
        }
      }

      /* Container styling */
      .shop-by-shape .section-container {
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      @media screen and (min-width: 1200px) {
        .shop-by-shape .section-container {
          padding: 0 2rem;
        }
      }

      @media screen and (min-width: 1600px) {
        .shop-by-shape .section-container {
          padding: 0 3rem;
        }
      }

      /* Title and subtitle styling */
      .shop-by-shape .section-header {
        margin-bottom: 3rem;
      }
      h2.italic-title {
      font-family: 'Cormorant', serif;
      font-style: italic;
      font-weight: 500;
      font-size: 40px;
      line-height: 62px;
      color: rgb(32, 32, 37);
    }

      .shop-by-shape .subtitle {
        display: block;
        width: 100%;
        margin-bottom: 10px;
        color: {{ section.settings.subtitle_color }};
        font-size: 1.4rem;
        letter-spacing: 0.1rem;
        font-weight: 500;
        text-transform: uppercase;
      }

      .shop-by-shape .title {
        font-style: {{ section.settings.title_style }};
        display: block;
        width: 100%;
        color: {{ section.settings.title_color }};
        margin-bottom: 0;
        font-weight: 500;
        line-height: 1.2;
      }

      /* Alignment styles */
      .shop-by-shape .section-header.text-left {
        text-align: left;
      }

      .shop-by-shape .section-header.text-center {
        text-align: center;
      }

      .shop-by-shape .section-header.text-right {
        text-align: right;
      }

      /* Slider Container */
      .shop-by-shape .shape-slider-container {
        position: relative;
        width: 100%;
        overflow: hidden;
        margin: 0 -1.5rem;
        {% comment %} padding: 0 1.5rem; {% endcomment %}
      }

      @media screen and (min-width: 750px) {
        .shop-by-shape .shape-slider-container {
          margin: 0 -2rem;
          padding: 0 2rem;
        }
      }
      @media (max-width: 749px) {
      h2.italic-title {
        font-size: 25px;
        line-height: 36px;
      }
    }

      /* Horizontal Scroll Container */
      .shop-by-shape .shape-slider {
        display: flex;
        overflow-x: auto;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        gap: {{ section.settings.gap_between_items }}px;
        scrollbar-width: none; /* Hide scrollbar for Firefox */
        padding-bottom: 20px;
      }

      .shop-by-shape .shape-slider::-webkit-scrollbar {
        display: none; /* Hide scrollbar for Chrome/Safari */
      }

      /* Individual Shape Cards - Responsive columns */
      .shop-by-shape .shape-card {
        flex: 0 0 auto;
        scroll-snap-align: start;
        width: calc(60% - {{ section.settings.gap_between_items }}px);
        max-width: 280px;
      }

      @media screen and (min-width: 640px) {
        .shop-by-shape .shape-card {
          width: calc(33.333% - {{ section.settings.gap_between_items | times: 0.666 }}px);
        }
      }

      @media screen and (min-width: 768px) {
        .shop-by-shape .shape-card {
          width: calc(25% - {{ section.settings.gap_between_items | times: 0.75 }}px);
        }
      }

      @media screen and (min-width: 1024px) {
        .shop-by-shape .shape-card {
          width: calc(20% - {{ section.settings.gap_between_items | times: 0.8 }}px);
        }
      }

      @media screen and (min-width: 1280px) {
        .shop-by-shape .shape-card {
          width: calc(16.666% - {{ section.settings.gap_between_items | times: 0.833 }}px);
        }
      }

      @media screen and (min-width: 1440px) {
        .shop-by-shape .shape-card {
          width: calc(14.285% - {{ section.settings.gap_between_items | times: 0.857 }}px);
        }
      }

      @media screen and (min-width: 1600px) {
        .shop-by-shape .shape-card {
          width: calc(12.5% - {{ section.settings.gap_between_items | times: 0.875 }}px);
        }
      }

      @media screen and (min-width: 1920px) {
        .shop-by-shape .shape-card {
          width: calc(11.111% - {{ section.settings.gap_between_items | times: 0.889 }}px);
        }
      }

      /* Alternative: Grid layout for desktop if preferred */
      {% if section.settings.use_grid_layout %}
      @media screen and (min-width: 990px) {
        .shop-by-shape .shape-slider {
          display: grid;
          grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
          gap: {{ section.settings.gap_between_items }}px;
          overflow-x: visible;
        }

        .shop-by-shape .shape-card {
          width: 100%;
          max-width: none;
        }

        .shop-by-shape .slider-buttons,
        .shop-by-shape .slider-dots,
        .shop-by-shape .scroll-progress-track {
          display: none;
        }
      }
      {% endif %}

      /* Card styling */
      .shop-by-shape .card-wrapper {
        height: 100%;
        transition: transform 0.3s ease;
      }

      .shop-by-shape .card-wrapper:hover {
        transform: translateY(-5px);
      }

      .shop-by-shape .card {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: transparent;
      }

      .shop-by-shape .card__inner {
        border-radius: {{ section.settings.image_border_radius }}px;
        overflow: hidden;
        background-color: #f5f5f5;
        position: relative;
        width: 100%;
      }

      /* Image ratio handling */
      .shop-by-shape .card__media {
        position: relative;
        width: 100%;
        overflow: hidden;
        background-color: #f8f8f8;
      }

      /* Square (1:1) */
      .shop-by-shape .card__media.ratio-square {
        padding-top: 100%;
      }

      /* Landscape (4:3) */
      .shop-by-shape .card__media.ratio-landscape {
        padding-top: 75%;
      }

      /* Portrait (2:3) */
      .shop-by-shape .card__media.ratio-portrait {
        padding-top: 133.33%;
      }

      /* Wide (16:9) */
      .shop-by-shape .card__media.ratio-wide {
        padding-top: 56.25%;
      }

      .shop-by-shape .card__media .media {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .shop-by-shape .card__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transition: transform 0.5s ease;
        display: block;
      }

      .shop-by-shape .card-wrapper:hover .card__media img {
        transform: scale(1.08);
      }

      /* Placeholder styling */
      .shop-by-shape .placeholder-svg {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f0f0f0 0%, #e0e0e0 100%);
        color: #999;
      }

      .shop-by-shape .placeholder-svg svg {
        width: 60%;
        height: 60%;
        opacity: 0.6;
      }

      /* Card information */
      .shop-by-shape .card__information {
        padding: 1.8rem 0.5rem 0 0.5rem;
        text-align: center;
      }

      .shop-by-shape .card__heading {
        font-size: 1.8rem;
        margin: 0;
        font-weight: {{ section.settings.title_font_weight }};
        line-height: 1.4;
      }

      .shop-by-shape .card__heading a {
        color: {{ section.settings.collection_title_color }};
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .shop-by-shape .card__heading a:hover {
        text-decoration: underline;
        text-underline-offset: 0.3rem;
        color: {{ section.settings.collection_title_color | color_modify: 'alpha', 0.7 }};
      }

      @media screen and (max-width: 749px) {
        .shop-by-shape .card__heading {
          font-size: 1.6rem;
        }
        .shop-by-shape .card__information {
          padding: 1.2rem 0.5rem 0 0.5rem;
        }
      }

      /* Navigation Buttons */
      .shop-by-shape .slider-buttons {
        margin-top: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
      }

      .shop-by-shape .slider-button {
        background: transparent;
        border: 2px solid {{ section.settings.collection_title_color }};
        width: 44px;
        height: 44px;
        border-radius: 50%;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        color: {{ section.settings.collection_title_color }};
      }

      .shop-by-shape .slider-button:hover:not(:disabled) {
        background: {{ section.settings.collection_title_color }};
        color: white;
        transform: scale(1.05);
      }

      .shop-by-shape .slider-button:disabled {
        opacity: 0.3;
        cursor: not-allowed;
      }

      .shop-by-shape .slider-counter {
        font-size: 1.4rem;
        font-weight: 500;
        color: {{ section.settings.collection_title_color }};
      }

      /* ===== Scroll indicator dots (plain round dots, only color changes on active) ===== */
      .shop-by-shape .slider-dots {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: {{ section.settings.dot_gap }}px;
        margin-top: 2rem;
      }

      .shop-by-shape .slider-dot {
        flex: 0 0 auto;
        width: {{ section.settings.dot_size }}px;
        height: {{ section.settings.dot_size }}px;
        border-radius: 50%;
        background-color: {{ section.settings.dot_color }};
        opacity: 1;
        cursor: pointer;
        transition: background-color 0.25s ease, transform 0.25s ease;
        border: none;
        padding: 0;
      }

      .shop-by-shape .slider-dot.active {
        background-color: {{ section.settings.dot_active_color }};
      }

      /* Hide dots on mobile if needed */
      @media screen and (max-width: 749px) {
        .shop-by-shape .slider-dots {
          display: {{ section.settings.show_mobile_dots }};
        }
      }

      /* ===== Thin scroll progress line (small track + moving fill bar under the slider) ===== */
      .shop-by-shape .scroll-progress-track {
        width: {{ section.settings.scroll_line_width }}px;
        max-width: 90%;
        height: {{ section.settings.scroll_line_height }}px;
        margin: 1.6rem auto 0;
        background-color: {{ section.settings.scroll_line_track_color }};
        border-radius: {{ section.settings.scroll_line_height }}px;
        overflow: hidden;
        position: relative;
      }

      .shop-by-shape .scroll-progress-fill {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 30%;
        background-color: {{ section.settings.scroll_line_fill_color }};
        border-radius: inherit;
        will-change: transform, width;
      }

      /* Italic style for specific headings if needed */
      .shop-by-shape .italic-title {
        font-style: italic;
      }

      @media screen and (min-width: 1024px) {
      .shop-by-shape {
        display: none !important;
      }
    }
    /* HIDE ON DESKTOP */
    @media screen and (min-width: 769px) {
      .shop-by-shape {
        display: none !important;
      }
    }

      .cc-carousel__scroll-indicator{
