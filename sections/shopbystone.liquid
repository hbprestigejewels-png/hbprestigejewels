<div class="shop-by-shape color-{{ section.settings.color_scheme }} gradient" id="shop-by-shape-{{ section.id }}">
  <div class="section-container">
    <!-- Section Header -->
    <div class="section-header {% if section.settings.text_alignment == 'left' %}text-left{% elsif section.settings.text_alignment == 'center' %}text-center{% elsif section.settings.text_alignment == 'right' %}text-right{% endif %}">
      {%- if section.settings.subtitle != blank -%}
        <div class="subtitle">
          {{ section.settings.subtitle | escape }}
        </div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="title {{ section.settings.heading_size }} {% if section.settings.title_style == 'italic' %}italic-title{% endif %}">
          {{ section.settings.title | escape }}
        </h2>
      {%- endif -%}
    </div>

    <!-- Slider Container -->
    <div class="shape-slider-container">
      <div class="shape-slider" id="shape-slider-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="shape-card" id="shape-card-{{ section.id }}-{{ forloop.index }}">
            <div class="card-wrapper">
              <div class="card card--standard card--media">
                <div class="card__inner color-{{ section.settings.card_color_scheme }} gradient">
                  <div
                    class="
                      card__media
                      {% if section.settings.image_ratio == '100' %}ratio-square
                      {% elsif section.settings.image_ratio == '75' %}ratio-landscape
                      {% elsif section.settings.image_ratio == '130' %}ratio-portrait
                      {% elsif section.settings.image_ratio == '60' %}ratio-wide
                      {% endif %}
                    "
                  >
                    <div class="media">
                      {%- if block.settings.shape_image != blank -%}
                        {%- assign image = block.settings.shape_image -%}
                        <img
                          srcset="
                            {%- if image.width >= 165 -%}{{ image | image_url: width: 165 }} 165w,{%- endif -%}
                            {%- if image.width >= 360 -%}{{ image | image_url: width: 360 }} 360w,{%- endif -%}
                            {%- if image.width >= 535 -%}{{ image | image_url: width: 535 }} 535w,{%- endif -%}
                            {%- if image.width >= 750 -%}{{ image | image_url: width: 750 }} 750w,{%- endif -%}
                            {%- if image.width >= 1070 -%}{{ image | image_url: width: 1070 }} 1070w,{%- endif -%}
                            {%- if image.width >= 1500 -%}{{ image | image_url: width: 1500 }} 1500w,{%- endif -%}
                            {{ image | image_url }} {{ image.width }}w
                          "
                          src="{{ image | image_url: width: 535 }}"
                          sizes="(min-width: 1920px) calc(11.11vw), (min-width: 1600px) calc(12.5vw), (min-width: 1440px) calc(14.28vw), (min-width: 1280px) calc(16.66vw), (min-width: 1024px) calc(20vw), (min-width: 768px) calc(25vw), (min-width: 640px) calc(33.33vw), calc(60vw - 20px)"
                          alt="{{ image.alt | default: block.settings.shape_title | escape }}"
                          loading="lazy"
                          width="{{ image.width }}"
                          height="{{ image.height }}"
                          class="motion-reduce"
                        >
                      {%- else -%}
                        <div class="placeholder-svg">
                          {{ 'image' | placeholder_svg_tag }}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
                <div class="card__information">
                  <h3 class="card__heading">
                    {%- if block.settings.shape_link != blank -%}
                      <a href="{{ block.settings.shape_link }}">
                        {{ block.settings.shape_title | escape }}
                      </a>
                    {%- else -%}
                      {{ block.settings.shape_title | escape }}
                    {%- endif -%}
                  </h3>
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!--
      Navigation Controls (mobile-only slider controls; the whole section is already hidden on desktop via CSS, so this no longer depends on the desktop grid setting)
    -->
    {%- if section.settings.enable_navigation and section.blocks.size > 1 -%}
      <div class="slider-buttons">
        <button
          type="button"
          class="slider-button slider-button--prev"
          name="previous"
          aria-label="Previous slide"
          disabled
        >
          <svg
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 10 6"
            width="10"
            height="6"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor" transform="rotate(90 5 3)">
            </path>
          </svg>
        </button>
        <div class="slider-counter caption">
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        </div>
        <button type="button" class="slider-button slider-button--next" name="next" aria-label="Next slide">
          <svg
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 10 6"
            width="10"
            height="6"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor" transform="rotate(-90 5 3)">
            </path>
          </svg>
        </button>
      </div>

      <!-- Thin scroll progress line -->
      {%- if section.settings.enable_scroll_line -%}
        <div class="scroll-progress-track">
          <div class="scroll-progress-fill" id="scroll-progress-{{ section.id }}"></div>
        </div>
      {%- endif -%}
    {%- endif -%}

    <!-- Dot Indicators -->
    {%- if section.settings.enable_dots -%}
      <div class="slider-dots">
        {%- for block in section.blocks -%}
          <button
            class="slider-dot{% if forloop.first %} active{% endif %}"
            data-slide="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const wrapper = document.getElementById('shop-by-shape-' + sectionId);
    if (!wrapper) return;

    const slider = wrapper.querySelector('#shape-slider-' + sectionId);
    if (!slider) return;

    let currentIndex = 0;
    let slideWidth = 0;
    let totalSlides = {{ section.blocks.size }};

    const dots = wrapper.querySelectorAll('.slider-dots .slider-dot');
    const prevButton = wrapper.querySelector('.slider-buttons .slider-button--prev');
    const nextButton = wrapper.querySelector('.slider-buttons .slider-button--next');
    const currentCounter = wrapper.querySelector('.slider-buttons .slider-counter--current');
    const progressTrack = wrapper.querySelector('.scroll-progress-track');
    const progressFill = wrapper.querySelector('#scroll-progress-' + sectionId);

    // Function to update slide width
    function updateSlideWidth() {
      const firstCard = slider.querySelector('.shape-card');
      if (firstCard) {
        const gap = {{ section.settings.gap_between_items }};
        slideWidth = firstCard.offsetWidth + gap;
      }
    }

    // Function to update the thin scroll progress line
    function updateProgressBar() {
      if (!progressFill || !progressTrack) return;

      const trackWidth = progressTrack.clientWidth;
      const scrollWidth = slider.scrollWidth;
      const visibleWidth = slider.clientWidth;

      if (scrollWidth <= visibleWidth) {
        progressFill.style.width = '100%';
        progressFill.style.transform = 'translateX(0px)';
        return;
      }

      const minFillRatio = 0.15; // fill never gets smaller than 15% of the track
      const fillRatio = Math.max(visibleWidth / scrollWidth, minFillRatio);
      const fillWidth = fillRatio * trackWidth;

      const maxScrollLeft = scrollWidth - visibleWidth;
      const scrollRatio = maxScrollLeft > 0 ? (slider.scrollLeft / maxScrollLeft) : 0;
      const maxTranslate = trackWidth - fillWidth;

      progressFill.style.width = fillWidth + 'px';
      progressFill.style.transform = 'translateX(' + (scrollRatio * maxTranslate) + 'px)';
    }

    // Function to update active dot and counter
    function updateActiveState() {
      const scrollPosition = slider.scrollLeft;
      const newIndex = slideWidth ? Math.round(scrollPosition / slideWidth) : 0;
      currentIndex = Math.min(Math.max(newIndex, 0), totalSlides - 1);

      // Update dots
      dots.forEach((dot, index) => {
        dot.classList.toggle('active', index === currentIndex);
      });

      // Update counter
      if (currentCounter) {
        currentCounter.textContent = currentIndex + 1;
      }

      // Update button states
      if (prevButton) {
        prevButton.disabled = currentIndex === 0;
      }
      if (nextButton) {
        nextButton.disabled = currentIndex >= totalSlides - 1;
      }

      // Update the thin progress line
      updateProgressBar();
    }

    // Scroll event handler
    function handleScroll() {
      window.requestAnimationFrame(updateActiveState);
    }

    // Navigation functions
    function scrollPrev() {
      if (currentIndex > 0) {
        slider.scrollBy({ left: -slideWidth, behavior: 'smooth' });
      }
    }

    function scrollNext() {
      if (currentIndex < totalSlides - 1) {
        slider.scrollBy({ left: slideWidth, behavior: 'smooth' });
      }
    }

    function scrollToSlide(index) {
      slider.scrollTo({ left: index * slideWidth, behavior: 'smooth' });
    }

    // Slider is mobile-only (desktop is hidden entirely via CSS), so listeners
    // always attach here regardless of the "use grid layout on desktop" setting.
    slider.addEventListener('scroll', handleScroll);

    if (prevButton) {
      prevButton.addEventListener('click', scrollPrev);
    }
    if (nextButton) {
      nextButton.addEventListener('click', scrollNext);
    }

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => scrollToSlide(index));
    });

    // Initialize
    function init() {
      updateSlideWidth();
      updateActiveState();
    }

    // Run on load and resize
    window.addEventListener('load', init);
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateSlideWidth();
        updateActiveState();
      }, 250);
    });

    // Initial call
    setTimeout(init, 100);
  })();
</script>

{% schema %}
{
  "name": "Shop by Shape",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
