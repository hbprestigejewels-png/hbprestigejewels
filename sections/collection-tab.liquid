{% render 'stylesheet-async', file: 'component-card.css' %}
{% render 'stylesheet-async', file: 'component-price.css' %}
{% render 'stylesheet-async', file: 'component-slider.css' %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="collection-tab-wrapper section-{{ section.id }}-padding">
  <div class="page-width">
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
        {%- unless section.settings.subtitle == blank -%}
          <p class="subtitle">{{ section.settings.subtitle }}</p>
        {%- endunless -%}
      </div>
    {%- endunless -%}

    <div class="tabs-listing">
      <!-- Tab Headers (Desktop & Mobile) -->
      <div class="tabs-header">
        <ul
          class="cl-tabs"
          style="--fs:{{ section.settings.tab_font_size }}px; --fw:{{ section.settings.tab_font_weight }}; --cl:{{ section.settings.tab_text_color }}; --bg:{{ section.settings.tab_bg_color }}; --bd:{{ section.settings.tab_border_color }}; --bdr:{{ section.settings.tab_border_radius }}px; --cla:{{ section.settings.tab_active_text_color }}; --bga:{{ section.settings.tab_active_bg_color }}; --bda:{{ section.settings.tab_active_border_color }};"
        >
          {% for block in section.blocks %}
            <li class="{% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}>
              <a class="tablink" href="#tab-{{ block.id }}" data-tab-id="tab-{{ block.id }}">
                {{ block.settings.tab_title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>

      <!-- Tab Content Containers -->
      <div
        class="tab-content-wrap"
        style="--bdr:{{ section.settings.tab_border_radius }}px; --acfs:12px; --acfw:400; --accl:#111111; --acbg:#eeeeee; --accla:#ffffff; --acbga:#111111;"
      >
        {% for block in section.blocks %}
          <div
            id="tab-{{ block.id }}"
            class="tab-content"
            {% unless forloop.first %}
              style="display: none;"
            {% endunless %}
          >
            <div class="collection-tab-grid">
              {%- assign collection_ref = collections[block.settings.collection] -%}
              {%- assign products_to_show = block.settings.products_to_show | default: 6 -%}

              {% if collection_ref != blank and collection_ref.products_count > 0 %}
                <ul
                  class="grid product-grid contains-card contains-card--product grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down"
                  role="list"
                >
                  {% for product in collection_ref.products limit: products_to_show %}
                    <li class="grid__item">
                      {% render 'card-product',
                        card_product: product,
                        media_aspect_ratio: section.settings.image_ratio,
                        show_secondary_image: section.settings.show_secondary_image,
                        show_vendor: section.settings.show_vendor,
                        show_rating: section.settings.show_rating,
                        show_quick_add: section.settings.enable_quick_add,
                        section_id: section.id
                      %}
                    </li>
                  {% endfor %}
                </ul>

                {%- if block.settings.show_view_all and collection_ref.all_products_count > products_to_show -%}
                  <div class="center view-all-wrapper">
                    <a href="{{ collection_ref.url }}" class="button button--secondary">
                      {{ 'sections.featured_collection.view_all' | t }}
                    </a>
                  </div>
                {%- endif -%}

              {% else %}
                <div class="placeholder-section">
                  <p>Collection</p>
                  {% for i in (1..products_to_show) %}
                    <div class="grid__item">
                      <div class="card-wrapper">
                        <div class="card card--product">
                          <div class="card__inner">
                            <div class="media media--transparent media--{{ section.settings.image_ratio | default: 'square' }}">
                              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
                            </div>
                            <div class="card__content" style="padding-left: 10px;">
                              <h3 class="card__heading">Example Collection Title</h3>
                              <div class="card-information">
                                <span class="caption-large light">$19.99</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<!-- Tab Switching JavaScript -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const tabs = document.querySelectorAll('.collection-tab-wrapper .tabs-header .tablink');
    const contents = document.querySelectorAll('.collection-tab-wrapper .tab-content');

    function activateTab(tabId) {
      // Remove active class from all tab headers
      document.querySelectorAll('.collection-tab-wrapper .tabs-header li').forEach((item) => {
        item.classList.remove('active');
      });

      // Hide all tab contents
      contents.forEach((content) => {
        content.style.display = 'none';
      });

      // Add active class to the clicked tab's parent li
      const activeTabLink = document.querySelector(
        `.collection-tab-wrapper .tabs-header .tablink[data-tab-id="${tabId}"]`
      );
      if (activeTabLink) {
        activeTabLink.closest('li').classList.add('active');
      }

      // Show the corresponding content
      const activeContent = document.getElementById(tabId);
      if (activeContent) {
        activeContent.style.display = 'block';
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', function (e) {
        e.preventDefault();
        const tabId = this.getAttribute('data-tab-id');
        activateTab(tabId);
      });
    });

    // Activate the first tab by default (in case JavaScript runs after initial load)
    const firstTab = document.querySelector('.collection-tab-wrapper .tabs-header li.active .tablink');
    if (firstTab) {
      const firstTabId = firstTab.getAttribute('data-tab-id');
      activateTab(firstTabId);
    }
  });
</script>

{% schema %}
{
  "name": "Collection Tab",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "OUR BESTSELLER",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "default": "Describe your products, collection etc...",
      "label": "Section Subtitle"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "Tab Styling"
    },
    {
      "type": "range",
      "id": "tab_font_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Tab Font Size",
      "default": 14
    },
    {
      "type": "select",
      "id": "tab_font_weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400",
      "label": "Tab Font Weight"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "default": "#191919",
      "label": "Tab Text Color"
    },
    {
      "type": "color",
      "id": "tab_bg_color",
      "default": "#ffffff",
      "label": "Tab Background Color"
    },
    {
      "type": "color",
      "id": "tab_border_color",
      "default": "#191919",
      "label": "Tab Border Color"
    },
    {
      "type": "range",
      "id": "tab_border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tab Border Radius",
      "default": 3
    },
    {
      "type": "color",
      "id": "tab_active_text_color",
      "default": "#ffffff",
      "label": "Active Tab Text Color"
    },
    {
      "type": "color",
      "id": "tab_active_bg_color",
      "default": "#191919",
      "label": "Active Tab Background Color"
    },
    {
      "type": "color",
      "id": "tab_active_border_color",
      "default": "#000000",
      "label": "Active Tab Border Color"
    },
    {
      "type": "header",
      "content": "Product Grid Settings"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.featured-collection.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.featured-collection.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.featured-collection.settings.image_ratio.options__3.label"
        }
      ],
      "default": "square",
      "label": "t:sections.featured-collection.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.columns_desktop.label"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.featured-collection.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.featured-collection.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.featured-collection.settings.show_rating.label",
      "info": "t:sections.featured-collection.settings.show_rating.info"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
