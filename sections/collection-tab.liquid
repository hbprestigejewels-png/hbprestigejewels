          "label": "Tab Title",
          "default": "Tab Name"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Choose Collection"
        },
        {
          "type": "range",
          "id": "products_to_show",
          "min": 2,
          "max": 12,
          "step": 1,
          "default": 6,
          "label": "Number of products to show"
        },
        {
          "type": "checkbox",
          "id": "show_view_all",
          "default": false,
          "label": "Show 'View all' button"
