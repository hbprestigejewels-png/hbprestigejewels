<section class="custom-banner-text"
style="background: {{ section.settings.bg_color }};
padding-top:{{ section.settings.padding_top }}px;
padding-bottom:{{ section.settings.padding_bottom }}px;
font-family: {{ section.settings.font_family }};">

<div class="page-width">

<div class="custom-banner-grid">

<div class="custom-banner-image">
{% if section.settings.image != blank %}
<img
src="{{ section.settings.image | image_url: width: 1200 }}"
alt="{{ section.settings.heading }}"
loading="lazy"
decoding="async"
width="900"
height="600">
{% endif %}
</div>

<div class="custom-banner-content">

{% if section.settings.subheading != blank %}
<p class="banner-subheading"
style="font-size:{{ section.settings.subheading_size }}px;">
{{ section.settings.subheading }}
</p>
{% endif %}

{% if section.settings.heading != blank %}
<h2 class="banner-heading"
style="font-size:{{ section.settings.heading_size }}px;">
{{ section.settings.heading }}
</h2>
{% endif %}

{% if section.settings.text != blank %}
<div class="banner-description"
style="font-size:{{ section.settings.text_size }}px;">
{{ section.settings.text }}
</div>
{% endif %}

{% if section.settings.button_label != blank %}
<a href="{{ section.settings.button_link }}"
class="custom-banner-btn"
style="
font-size: {{ section.settings.button_font_size }}px;
background-color: {{ section.settings.button_bg }};
color: {{ section.settings.button_text_color }};
border-color: {{ section.settings.button_bg }};
">
{{ section.settings.button_label }}
</a>
{% endif %}

</div>
</div>
</div>
</section>

<style>

.custom-banner-grid{
display:flex;
align-items:center;
gap:60px;
}

.custom-banner-image{
flex:1;
}

.custom-banner-image img{
width:100%;
height:auto;
border-radius:6px;
}

.custom-banner-content{
flex:1;
}

.banner-subheading{
font-weight:600;
letter-spacing:1px;
margin-bottom:10px;
}

.banner-heading{
font-weight:700;
margin-bottom:20px;
line-height:1.3;
}

.banner-description{
line-height:1.6;
margin-bottom:25px;
}

.banner-button{
display:inline-block;
padding:12px 28px;
background:#df4800;
color:#fff;
text-decoration:none;
font-weight:600;
border-radius:4px;
}

.banner-button:hover{
opacity:0.9;
}

@media screen and (max-width: 990px){

.custom-banner-grid{
flex-direction:column;
text-align:center;
gap:30px;
}

}
.custom-banner-btn{
display:inline-block;
padding:12px 26px;
border:2px solid;
text-decoration:none;
font-weight:500;
transition:all .3s ease;
line-height:1.2;
}

.custom-banner-btn:hover{
background:#c63f00;
border-color:#c63f00;
color:#fff;
}

</style>

{% schema %}
{
"name": "Banner With Text Custom",
"settings": [

{
"type": "image_picker",
"id": "image",
"label": "Banner Image"
},

{
"type": "text",
"id": "subheading",
"label": "Subheading",
"default": "WHERE STYLE MEETS SIMPLICITY"
},

{
"type": "text",
"id": "heading",
"label": "Heading",
"default": "Deepika's Dazzle"
},

{
"type": "richtext",
"id": "text",
"label": "Description"
},

{
"type":"header",
"content":"Button Settings"
},
{
"type":"text",
"id":"button_label",
"label":"Button Label",
"default":"More Info"
},
{
"type":"url",
"id":"button_link",
"label":"Button Link"
},
{
"type":"range",
"id":"button_font_size",
"label":"Button Font Size",
"min":12,
"max":22,
"step":1,
"default":14
},
{
"type":"color",
"id":"button_bg",
"label":"Button Background",
"default":"#df4800"
},
{
"type":"color",
"id":"button_text_color",
"label":"Button Text Color",
"default":"#ffffff"
},

{
"type":"header",
"content":"Typography"
},

{
"type": "select",
"id": "font_family",
"label": "Font Family",
"default": "Poppins, sans-serif",
"options": [
{
"value": "Poppins, sans-serif",
"label": "Poppins"
},
{
"value": "Arial, sans-serif",
"label": "Arial"
},
{
"value": "Helvetica, sans-serif",
"label": "Helvetica"
}
]
},

{
"type":"range",
"id":"heading_size",
"label":"Heading Font Size",
"min":20,
"max":60,
"step":2,
"default":34
},

{
"type":"range",
"id":"subheading_size",
"label":"Subheading Font Size",
"min":10,
"max":30,
"step":1,
"default":15
},

{
"type":"range",
"id":"text_size",
"label":"Description Font Size",
"min":12,
"max":24,
"step":1,
"default":16
},

{
"type":"range",
"id":"button_size",
"label":"Button Font Size",
"min":12,
"max":20,
"step":1,
"default":14
},

{
"type":"header",
"content":"Layout"
},

{
"type":"color",
"id":"bg_color",
"label":"Background Color",
"default":"#fcf2ed"
},

{
"type":"range",
"id":"padding_top",
"label":"Top Padding",
"min":0,
"max":150,
"step":5,
"default":80
},

{
"type":"range",
"id":"padding_bottom",
"label":"Bottom Padding",
"min":0,
"max":150,
"step":5,
"default":80
}

],

"presets":[
{
"name":"Banner With Text Custom"
}
]
}
{% endschema %}