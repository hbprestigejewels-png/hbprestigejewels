{%- liquid
  # Section settings with defaults
  assign section_padding_top = section.settings.padding_top | default: 80
  assign section_padding_bottom = section.settings.padding_bottom | default: 80
  assign bg_color = section.settings.background_color | default: '#f9f6f1'
  assign heading = section.settings.heading | default: "Sustainable trends you'll love forever."
  assign description = section.settings.description | default: 'The elasticity and excellent shape memory of Stretch laminates allow the garments to be more comfortable'
  assign button_text = section.settings.button_text | default: 'Our Story'
  assign button_link = section.settings.button_link | default: '#'

  # Images
  assign image_1 = section.settings.image_1
  assign image_2 = section.settings.image_2

  assign video_1 = section.settings.video_1
  assign video_2 = section.settings.video_2

  assign front_media_type = section.settings.front_media_type
  assign back_media_type = section.settings.back_media_type
-%}

<div
  class="sustainable-trends-section"
  style="background-color: {{ bg_color }}; padding-top: {{ section_padding_top | append: 'px' }}; padding-bottom: {{ section_padding_bottom | append: 'px' }};"
>
  <div class="page-width">
    <div class="sustainable-trends-grid">
      <!-- Text Content Column -->
      <div class="sustainable-trends-content">
        <div class="content-inner">
          <h2 class="section-heading">{{ heading | escape }}</h2>
          <p class="section-description">{{ description }}</p>
          {% if button_text != blank %}
            <a href="{{ button_link }}" class="btn btn-outline-primary sustainable-btn">
              {{ button_text }}
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Images Column with Overlap Effect - Cadiant Style -->
      <div class="sustainable-trends-images">
        <div class="image-stack">
          {% if image_1 != blank %}
            <div class="image-stack__item image-stack__item--front">
              {% if front_media_type == 'video' and video_1 != blank %}
                <div role="img" aria-label="HB Prestige Jewels Video">
                {{
                  video_1
                  | video_tag:
                    autoplay: section.settings.front_video_autoplay,
                    loop: section.settings.front_video_loop,
                    muted: section.settings.front_video_muted,
                    controls: section.settings.front_video_controls,
                    playsinline: true,
                    preload: 'none',
                    class: 'stack-video'
                }}
                </div>

              {% elsif image_1 != blank %}
                {{
                  image_1
                  | image_url: width: 800
                  | image_tag: class: 'stack-image', alt: 'hb prestige jewels', loading: 'lazy'
                }}
              {% endif %}
            </div>
          {% else %}
            <div class="image-stack__item image-stack__item--front placeholder-image">
              {{
                'image'
                | placeholder_svg_tag: 'stack-image placeholder-svg',
                  role: 'img',
                  aria_label: 'Product image placeholder',
                  alt: section.settings.image.alt
                | default: 'hb prestige jewels'
              }}
            </div>
          {% endif %}

          {% if image_2 != blank %}
            <div class="image-stack__item image-stack__item--back">
              {% if back_media_type == 'video' and video_2 != blank %}
                <div role="img" aria-label="HB Prestige Jewels Video">
                {{
                  video_2
                  | video_tag:
                    autoplay: section.settings.back_video_autoplay,
                    loop: section.settings.back_video_loop,
                    muted: section.settings.back_video_muted,
                    controls: section.settings.back_video_controls,
                    playsinline: true,
                    preload: 'none',
                    class: 'stack-video'
                }}
                </div>

              {% elsif image_2 != blank %}
                {{
                  image_2
                  | image_url: width: 1000
                  | image_tag: class: 'stack-image', alt: 'Jewellery Video Preview', loading: 'lazy'
                }}
              {% endif %}
            </div>
          {% else %}
            <div class="image-stack__item image-stack__item--back placeholder-image">
              {{
                'image'
                | placeholder_svg_tag: 'stack-image placeholder-svg',
                  role: 'img',
                  aria_label: 'Product image placeholder',
                  alt: section.settings.image.alt | default:"hb prestige jewels"
              }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sustainable Trends",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sustainable trends you'll love forever."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "The elasticity and excellent shape memory of Stretch laminates allow the garments to be more comfortable"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Front Image (overlapping on top-left)",
      "info": "Recommended aspect ratio: 4:5"
    },
    {
      "type": "video",
      "id": "video_1",
      "label": "Front Video"
    },
    {
      "type": "select",
      "id": "front_media_type",
      "label": "Front Media Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "checkbox",
      "id": "front_video_autoplay",
      "label": "Front Video Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "front_video_loop",
      "label": "Front Video Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "front_video_muted",
      "label": "Front Video Muted",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "front_video_controls",
      "label": "Show Front Video Controls",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Back Image (larger, bottom-right)",
      "info": "Recommended aspect ratio: 3:4"
    },
    {
      "type": "video",
      "id": "video_2",
      "label": "Back Video"
    },
    {
      "type": "select",
      "id": "back_media_type",
      "label": "Back Media Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "checkbox",
      "id": "back_video_autoplay",
      "label": "Back Video Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "back_video_loop",
      "label": "Back Video Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "back_video_muted",
      "label": "Back Video Muted",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "back_video_controls",
      "label": "Show Back Video Controls",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f9f6f1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "default": 80,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Sustainable Trends",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

{% style %}
    .sustainable-trends-section {
      width: 100%;
      overflow: hidden;
      padding-left: 15px;
    }

    .sustainable-trends-grid {
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }

    @media screen and (min-width: 990px) {
      .sustainable-trends-grid {
        flex-direction: row;
        align-items: center;
        gap: 2rem;
      }

      .sustainable-trends-content {
        flex: 1;
      }

      .sustainable-trends-images {
        flex: 1;
      }
    }

    .content-inner {
      max-width: 500px;
      margin: 0 auto;
    }

    @media screen and (min-width: 990px) {
      .content-inner {
        margin: 0 0 0 0;
      }
    }

    .section-heading {
      font-family: var(--font-heading-family);
      font-size: calc(var(--font-heading-scale) * 3rem);
      margin: 0 0 1.5rem 0;
      line-height: 1.2;
      color: #000;
    }

    @media screen and (min-width: 750px) {
      .section-heading {
        font-size: calc(var(--font-heading-scale) * 3.6rem);
      }
    }

    .section-description {
      font-family: var(--font-body-family);
      font-size: 1.5rem;
      line-height: 1.5;
      margin-bottom: 2.5rem;
      color: #4a4a4a;
    }

    .sustainable-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 1rem 2.5rem;
      font-size: 1.4rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-decoration: none;
      transition: all 0.2s ease;
      border: 1px solid #000;
      background: transparent;
      color: #000;
      border-radius:20px !important;
    }

    .sustainable-btn:hover {
      background: #000;
      color: #fff;
    }

    /* Image Stack Overlap Effect - Cadiant Style */
    .image-stack {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 550px;
    }

    @media screen and (min-width: 750px) {
      .image-stack {
        min-height: 600px;
      }
    }

    @media screen and (min-width: 1200px) {
      .image-stack {
        min-height: 650px;
      }
    }

    .image-stack__item {
      position: absolute;
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    /* Back image (larger, bottom-right) - 3:4 aspect ratio */
    .image-stack__item--back {
      width: 72%;
      right: 0;
      bottom: 0;
      z-index: 1;
      border-radius:20px !important;
    }

    .image-stack__item--back .stack-image {
      aspect-ratio: 4 / 5;
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }

    /* Front image (overlapping, top-left) - 4:5 aspect ratio */
    .image-stack__item--front {
      width: 62%;
      left: 0;
      top: 0;
      z-index: 2;
      border-radius:20px !important;
    }

    .image-stack__item--front .stack-image {
      aspect-ratio: 4 / 5;
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }

    /* Desktop fine-tuning */
    @media screen and (min-width: 990px) {
      .image-stack__item--back {
        width: 68%;
      }

      .image-stack__item--front {
        width: 58%;
      }
    }

    /* Placeholder styling */
    .placeholder-image {
      background-color: #e8e8e8;
      width: 100%;
      height: 100%;
      min-height: 300px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .placeholder-svg {
      width: 80%;
      height: auto;
      fill: #9ca3af;
    }

    /* Mobile adjustments */
    @media screen and (max-width: 749px) {
      .sustainable-trends-section {
        padding-top: 40px !important;
        padding-bottom: 40px !important;
      }

      .section-heading {
        font-size: 2.6rem;
      }

      .image-stack {
        min-height: 420px;
        margin-top: 2rem;
      }

      .image-stack__item--back {
        width: 75%;
      }

      .image-stack__item--front {
        width: 65%;
      }

      .stack-video{
      width:100%;
      height:300px !important;
      object-fit:cover;
      display:block;
      border-radius:20px;
  }
    }

  .stack-image,
  .stack-video{
      width:100%;
      height:500px ;
      object-fit:cover;
      display:block;
      border-radius:20px;
  }
{% endstyle %}
