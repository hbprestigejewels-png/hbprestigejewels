<script>
  (function() {
    function initTopHeaderTimer() {
      var STORAGE_KEY = 'hb_top_deal_timer_end_v1';
      var ONE_DAY_MS = 24 * 60 * 60 * 1000;
      var now = Date.now();
      var storedTarget = localStorage.getItem(STORAGE_KEY);
      var targetTime;

      if (!storedTarget || now >= parseInt(storedTarget, 10)) {
        targetTime = now + ONE_DAY_MS;
        localStorage.setItem(STORAGE_KEY, targetTime.toString());
      } else {
        targetTime = parseInt(storedTarget, 10);
      }

      function updateTimer() {
        var current = Date.now();
        var diff = targetTime - current;

        if (diff <= 0) {
          targetTime = Date.now() + ONE_DAY_MS;
          localStorage.setItem(STORAGE_KEY, targetTime.toString());
          diff = ONE_DAY_MS;
        }

        var hours = Math.floor(diff / (1000 * 60 * 60));
        var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        var seconds = Math.floor((diff % (1000 * 60)) / 1000);

        var hEl = document.getElementById('topTimerH');
        var mEl = document.getElementById('topTimerM');
        var sEl = document.getElementById('topTimerS');

        if (hEl) hEl.textContent = hours < 10 ? '0' + hours : hours;
        if (mEl) mEl.textContent = minutes < 10 ? '0' + minutes : minutes;
        if (sEl) sEl.textContent = seconds < 10 ? '0' + seconds : seconds;
      }

      updateTimer();
      setInterval(updateTimer, 1000);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTopHeaderTimer);
    } else {
      initTopHeaderTimer();
    }
  })();
</script>

