<style>
  .top-header-wrapper{
    max-width:100%;
    background:#000;
    color:#fff;
    font-size:12px;
    text-align:center;
    position: relative;
    z-index: 10;
    transform: translate3d(0, 0, 0);
    -webkit-transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    pointer-events: auto;
    {% comment %} display:none !important ; {% endcomment %}
  }

  .top-header{
    max-width:100%;
    margin:auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: 0px 10px;
    position:relative;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }

  .top-left{
    display:flex;
    gap:20px;
    align-items:center;
    flex-shrink: 0;
  }

  .top-center{
    text-align:center;
    font-weight:500;
    flex: 1;
  }

  .top-right ul{
    display:flex;
    gap:14px;
    list-style:none;
    padding:0;
    margin:0;
    flex-shrink: 0;
  }

  .top-right a{
    color:#fff;
    text-decoration:none;
    font-size:12px;
    display: inline-flex;
    align-items: center;
    transition: opacity 0.2s ease;
  }

  .top-right a:hover{
    opacity:0.7;
  }

  .announcement-text {
      display: flex;
      justify-content: center; /* Centers horizontally in flex */
      align-items: center;     /* Centers vertically in flex */
      text-align: center;
      margin: 0 auto;          /* Standard centering trick */
      width: 100%;             /* Ensures it takes up the available space */
      flex: 1;
      position: relative;
      white-space: nowrap;
  }

  /* Social icons styling */
  .top-right svg {
    transition: transform 0.2s ease;
    vertical-align: middle;
    display: block;
  }

  .top-right a:hover svg {
    transform:scale(1.1);
  }

  /* Performance optimization */
  .top-header-wrapper * {
    -webkit-tap-highlight-color: transparent;
  }

  /* Mobile responsive - Optimized */
  @media(max-width:768px){
    .top-header-wrapper {
      position: relative;
      transform: none;
    }

    .top-header{
      flex-direction:column;
      gap:6px;
      padding-top: 6px;
      padding-bottom: 6px;
      transform: none;
    }

    .top-left{
      display:none;
    }

    .top-right{
      display:none;
    }

    {% comment %} .announcement-text{
      position:static;
      transform:none;
      white-space:normal;
      width: 100%;
    }

    .announcement-text p {
      margin: 0;
      animation: none;
    }
  } {% endcomment %}

  /* Small screen adjustments */
  @media(max-width:480px){
    .top-header{
      padding-left: 12px;
      padding-right: 12px;
    }

    .announcement-text p {
      margin: 0;
      font-size: 11px;
      line-height: 1.4;
    }
  }

  .top-deal-banner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 12.5px;
    letter-spacing: 0.3px;
    line-height: 1.2;
  }

  .top-deal-title {
    font-weight: 700;
    color: #ffd700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .top-deal-divider {
    opacity: 0.4;
  }

  .top-deal-timer-label {
    opacity: 0.85;
    font-weight: 400;
  }

  .top-deal-timer {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-weight: 600;
    color: #ffffff;
  }

  .top-deal-timer .timer-segment {
    background: rgba(255, 255, 255, 0.18);
    padding: 1px 5px;
    border-radius: 4px;
    font-family: monospace, sans-serif;
    font-size: 11.5px;
    letter-spacing: 0.5px;
  }

  .top-deal-timer .timer-segment b {
    font-weight: 700;
    color: #ffffff;
  }

  @media(max-width: 768px){
    .top-deal-banner {
      font-size: 11px;
      gap: 4px;
    }
    .top-deal-timer .timer-segment {
      padding: 1px 4px;
      font-size: 10.5px;
    }
  }

  /* Prevent glitch on iOS devices */
  @supports (-webkit-touch-callout: none) {
    .top-header-wrapper {
      position: relative;
      transform: none;
    }

    .top-header {
      transform: none;
    }
  }
</style>

