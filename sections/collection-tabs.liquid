{% render 'stylesheet-async', file: 'component-card.css' %}
{% if request.page_type == 'product' or request.page_type == 'collection' %}
  {% render 'stylesheet-async', file: 'component-price.css' %}
{% endif -%}
{% render 'stylesheet-async', file: 'component-slider.css' %}
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .collection-tabs-section {
    padding: 20px 0;
    width: 100%;
    overflow: hidden;
  }

  /* FULL WIDTH WRAPPER */
  .ct-wrapper-full {
    width: 100% !important;
    max-width: 100% !important;
    padding: 0 2rem !important;
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* Resetting the panel width */
  .ct-panel {
    display: none;
    width: 100%;
  }
  .ct-panel.active { display: block; }

  .ct-wrapper { padding: 40px 0; }

  /* Force panels to ignore Dawn's default page-width constraints */
  .ct-panel.page-width {
    max-width: 100% !important;
    padding: 0 !important;
  }

  /* Tabs */
  .ct-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1rem;
    margin-bottom: 30px;
    padding: 0;
    list-style: none;
  }

  .ct-tab {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(253, 246, 243, 0.85) 45%, rgba(246, 230, 224, 0.7) 100%);
    border: 1.5px solid rgba(194, 133, 116, 0.65);
    border-radius: 9999px;
    font-size: 13.5px;
    font-weight: 500;
    text-transform: uppercase;
    padding: 8px 22px;
    cursor: pointer;
    color: #8f4c3b;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 12px rgba(194, 133, 116, 0.12), inset 0 1px 2px rgba(255, 255, 255, 0.9);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .ct-tab:hover:not(.active) {
    background: linear-gradient(135deg, rgba(255, 255, 255, 1) 0%, rgba(250, 236, 230, 0.95) 50%, rgba(242, 218, 210, 0.85) 100%);
    border-color: #b87b6c;
    color: #944b3b;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -2px rgba(194, 133, 116, 0.25);
  }

  .ct-tab.active {
    color: #ffffff !important;
    background: linear-gradient(135deg, #d89685 0%, #c28574 48%, #a66555 100%) !important;
    border-color: rgba(255, 255, 255, 0.55) !important;
    box-shadow: 0 8px 22px -4px rgba(184, 123, 108, 0.5), inset 0 1.5px 2px rgba(255, 255, 255, 0.6) !important;
    font-weight: 600;
  }

  /* Panels */
  .ct-panel { display:none; }
  .ct-panel.active { display:block; }

  /* Custom card styles to ensure Add to Cart button appears below price */
  .ct-grid {
    display: grid;
    gap: 16px;
  }

  .card-wrapper {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card__inner {
    flex-shrink: 0;
  }

  .card__content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    padding-left: 10px;
  }

  .card__information {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem 1rem;
  }

  .price {
    margin-bottom: 1rem;
  }

  .quick-add {
    margin-top: auto;
    padding: 0 1rem 1rem;
  }

  .quick-add__submit {
    width: 100%;
    margin-top: 0.5rem;
    white-space: nowrap;
  }

  /* Ensure price and add to cart are properly stacked */
  .card__information .price {
    order: 1;
  }

  .quick-add {
    order: 2;
  }

  /* MOBILE SLIDER FIX */
  @media (max-width: 749px) {
    .ct-wrapper-full {
      padding-left: 1rem !important;
      padding-right: 1rem !important;
    }

    .ct-grid {
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      gap: 12px !important;
      padding-bottom: 12px;
      -webkit-overflow-scrolling: touch;
    }

    .ct-grid li {
      scroll-snap-align: start;
      flex: 0 0 70%;
      max-width: 70%;
    }

    .card__inner {
      aspect-ratio: 1 / 1 !important;
      max-height: 250px;
    }

    .quick-add {
      padding: 0 0.75rem 0.75rem;
    }

    .card__information {
      padding: 1rem 0.75rem 0.5rem;
    }
  }

  .ct-heading {
    text-align: center;
    margin-bottom: 10px;
    font-size: 40px;
    color: #666;
  }

  .ct-subheading {
    font-size: 14px;
    color: #666;
    margin-top: 6px;
    margin-bottom: 18px;
  }

  /* MOBILE TAB FIX */
  @media (max-width: 749px) {
    .ct-tabs {
      display: flex;
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 8px;
      overflow-x: auto;
      padding: 0 10px 8px 10px;
      margin-bottom: 20px;
      scrollbar-width: none;
    }

    .ct-tabs::-webkit-scrollbar {
      display: none;
    }

    .ct-tab {
      flex: 0 0 auto;
      font-size: 11px;
      padding: 6px 14px;
      border-radius: 10px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign cols_desktop = section.settings.columns_desktop
  assign cols_mobile = section.settings.columns_mobile
  assign limit = section.settings.products_to_show
-%}

<section id="ctabs-{{ section.id }}" class="collection-tabs-section">
  <div class="{% if section.settings.full_width %}ct-wrapper-full{% else %}page-width{% endif %}">
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="ct-heading">
        {% if section.settings.title != blank %}
          <h2 class="title {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="ct-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <!-- TABS -->
    <div class="ct-tabs">
      {% for block in section.blocks %}
        {% assign col = collections[block.settings.collection] %}
        <button
          class="ct-tab {% if forloop.first %}active{% endif %}"
          data-target="panel-{{ section.id }}-{{ forloop.index }}"
        >
          {{ block.settings.label | default: col.title }}
        </button>
      {% endfor %}
    </div>

    {% comment %}
      PANELS

      Only the first (visible) panel is rendered as live DOM. Every other panel's
      grid is parked inside a <template>, which the browser parses but does not
      build elements for, and is cloned into place the first time its tab is
      clicked.

      Previously all panels were rendered eagerly: 7 tabs x 6 products meant 42
      product cards - roughly 390 KB of HTML and ~1,700 elements - of which the
      visitor could only ever see 6 at a time. That was the single largest
      contributor to both the document size and the DOM-size audit.
    {% endcomment %}
    {% for block in section.blocks %}
      {% assign col = collections[block.settings.collection] %}

      <div
        id="panel-{{ section.id }}-{{ forloop.index }}"
        class="page-width ct-panel {% if forloop.first %}active{% endif %}"
      >
        {%- unless forloop.first -%}<template data-ct-panel>{%- endunless -%}
        <ul
          data-id="{{ section.id }}"
          class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid--{{ section.settings.columns_desktop }}-col-desktop{% if section.settings.collection == blank %} grid--2-col-tablet-down{% else %} grid--{{ section.settings.columns_mobile }}-col-tablet-down{% endif %}"
          role="list"
          aria-label="{{ 'general.slider.name' | t }}"
        >
          {% assign skip_card_product_styles = false %}

          {%- if col.products.size > 0 -%}
            {%- if forloop.first -%}
              {% assign lazy_load = false %}
            {%- else -%}
              {% assign lazy_load = true %}
            {%- endif -%}
              {%- for product in col.products limit: section.settings.products_to_show -%}
                {% if lazy_load == false and forloop.index > cols_desktop %}
                  {% assign lazy_load = true %}
                {% endif %}
                <li
                  id="Slide-{{ section.id }}-{{ block.id }}-{{ forloop.index }}"
                  class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    lazy_load: lazy_load,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    skip_styles: skip_card_product_styles,
                    section_id: section.id,
                    quick_add: section.settings.quick_add
                  %}
                </li>
                {%- assign skip_card_product_styles = true -%}
              {%- endfor -%}
          {%- else -%}
            {%- for i in (1..section.settings.columns_desktop) -%}
              <li
                class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {% liquid
                  assign ridx = forloop.rindex
                  case ridx
                    when 5
                      assign ridx = 1
                    when 6
                      assign ridx = 2
                  endcase
                %}
                {%- assign placeholder_image = 'product-apparel-' | append: ridx -%}
                {%
                  render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: section.settings.image_shape,
                  lazy_load: forloop.index > cols_desktop,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  section_id: section.id,
                  quick_add: section.settings.quick_add
                %}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
        {%- unless forloop.first -%}</template>{%- endunless -%}
      </div>
    {% endfor %}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('ctabs-{{ section.id }}');
    if (!root) return;

    const tabs = root.querySelectorAll('.ct-tab');
    const panels = root.querySelectorAll('.ct-panel');

    /**
     * Panels other than the first ship as <template> content. Clone it into the
     * panel the first time that tab is opened, then drop the template so the
     * work happens exactly once.
     */
    function hydrate(panel) {
      const tpl = panel.querySelector(':scope > template[data-ct-panel]');
      if (!tpl) return;
      panel.replaceChild(tpl.content.cloneNode(true), tpl);
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetPanel = document.getElementById(tab.dataset.target);
        if (!targetPanel) return;

        // Hydrate before the panel becomes visible so nothing pops in.
        hydrate(targetPanel);

        tabs.forEach((t) => t.classList.remove('active'));
        panels.forEach((p) => p.classList.remove('active'));
        tab.classList.add('active');
        targetPanel.classList.add('active');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection Tabs",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our best collections"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h1", "label": "H1" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8,
      "label": "Products per tab"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show secondary image"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show rating"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "round", "label": "Round" },
        { "value": "arch", "label": "Arch" },
        { "value": "blob", "label": "Blob" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "standard",
      "label": "t:sections.main-collection-product-grid.settings.quick_add.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_1"
        },
        {
          "value": "standard",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_2"
        },
        {
          "value": "bulk",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_3"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Tab label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Tabs",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
