{% comment %}
  Main Banner - full-width / page-width clickable hero slider.

  Performance notes:
  - No third-party carousel library. The crossfade, autoplay, dots and per-slide
    video sync are handled by assets/banner-carousel.js (~6 KB, self-hosted).
    This removed a ~150 KB JS + ~18 KB CSS download from cdn.jsdelivr.net,
    along with the extra DNS + TLS handshake, from the critical path.
  - The first slide is marked active server-side and its image is served with
    fetchpriority="high", so the LCP element paints without waiting on any JS.
  - Later slides carry their URLs in data-src / data-srcset. Every slide is
    position:absolute at inset:0, so the browser considers them all to be in the
    viewport and loading="lazy" alone would NOT stop them downloading in
    parallel with the hero image.
  - The {% raw %}{% style %}{% endraw %} block deliberately precedes the markup. The slides are
    absolutely positioned, so until those rules are parsed the browser lays all
    of them out in normal flow at full height. Measured at ~0.9 CLS when the
    block sat after the markup.
{% endcomment %}

{%- liquid
  assign block_count = section.blocks.size
  assign autoplay_ms = 0
  if section.settings.autoplay_enable and block_count > 1
    assign autoplay_ms = section.settings.autoplay_speed | times: 1000
  endif
-%}

{%- for block in section.blocks -%}
  {%- if forloop.first -%}
    {%- assign first_desktop = block.settings.image_desktop -%}
    {%- assign first_mobile = block.settings.image_mobile | default: first_desktop -%}
    {%- if first_desktop -%}
      <link rel="preload" as="image" href="{{ first_desktop | image_url: width: 1200, format: 'webp' }}" media="(min-width: 750px)" fetchpriority="high">
    {%- endif -%}
    {%- if first_mobile -%}
      <link rel="preload" as="image" href="{{ first_mobile | image_url: width: 750, format: 'webp' }}" media="(max-width: 749px)" fetchpriority="high">
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- if block_count > 1 -%}
  <script src="{{ 'banner-carousel.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% style %}
  .main-banner-section { width: 100%; margin: 0; padding: 0; }
  .main-banner-section.page-width .page-width-wrap {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
  }

  .banner-carousel {
    display: block;
    position: relative;
    width: 100%;
    height: 80vh;
    min-height: 320px;
    overflow: hidden;
    border-radius: var(--banner-radius, 0px);
    background: #f4f4f4;
    /* Isolate the hero's paint so slide crossfades never invalidate the rest
       of the page's layout or paint tree. */
    contain: layout paint;
  }

  .banner-carousel__track { position: absolute; inset: 0; }

  .banner-carousel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    /* Kept out of the compositor and off the hit-test path until active. */
    visibility: hidden;
    transition: opacity 0.5s ease-in-out, visibility 0s linear 0.5s;
  }

  .banner-carousel__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s ease-in-out, visibility 0s linear 0s;
  }

  .banner-carousel__slide img,
  .banner-carousel__slide video,
  .banner-carousel__slide .banner-video,
  .banner-carousel__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .banner-carousel__link {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    text-decoration: none;
    background: transparent;
  }

  .banner-carousel__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.6rem;
    z-index: 3;
    display: flex;
    justify-content: center;
    gap: 0.8rem;
  }

  .banner-carousel__dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(122, 120, 120);
    cursor: pointer;
    transition: width 0.3s ease, border-radius 0.3s ease, background 0.3s ease;
  }

  .banner-carousel__dot.is-active {
    width: 30px;
    border-radius: 20px;
    background: rgb(49, 49, 49);
  }

  @media screen and (max-width: 749px) {
    .banner-carousel {
      height: auto;
      aspect-ratio: 1 / 1.15;
      min-height: 280px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner-carousel__slide { transition: none; }
  }
{% endstyle %}

<section
  id="main-banner-{{ section.id }}"
  class="main-banner-section {{ section.settings.layout }}"
>
  <div class="{% if section.settings.layout == 'page-width' %}page-width-wrap{% endif %}">
    <banner-carousel
      class="banner-carousel"
      data-autoplay="{{ autoplay_ms }}"
      style="--banner-radius: {{ section.settings.border_radius }}px;"
      {% if block_count > 1 %}
        role="region"
        aria-roledescription="carousel"
        aria-label="Banner carousel"
      {% endif %}
    >
      <div class="banner-carousel__track">
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_first = forloop.first
            assign desktop_img = block.settings.image_desktop
            assign mobile_img = block.settings.image_mobile | default: desktop_img
            assign desktop_is_video = false
            if block.settings.media_type_desktop == 'video' and block.settings.video != blank
              assign desktop_is_video = true
            endif
            assign mobile_is_video = false
            if block.settings.media_type_mobile == 'video' and block.settings.video_mobile != blank
              assign mobile_is_video = true
            endif
          -%}
          <div
            class="banner-carousel__slide{% if is_first %} is-active{% endif %}"
            {% unless is_first %}aria-hidden="true"{% endunless %}
            {{ block.shopify_attributes }}
          >
            {%- if desktop_is_video -%}
              {{
                block.settings.video
                | video_tag:
                  autoplay: block.settings.video_autoplay,
                  loop: block.settings.video_loop,
                  muted: block.settings.video_muted,
                  controls: block.settings.video_controls,
                  playsinline: true,
                  preload: 'none',
                  class: 'banner-video small-hide',
                  image_size: '1920x'
              }}
            {%- endif -%}

            {%- if mobile_is_video -%}
              {{
                block.settings.video_mobile
                | video_tag:
                  autoplay: block.settings.video_autoplay,
                  loop: block.settings.video_loop,
                  muted: block.settings.video_muted,
                  controls: block.settings.video_controls,
                  playsinline: true,
                  preload: 'none',
                  class: 'banner-video medium-hide large-up-hide',
                  image_size: '750x'
              }}
            {%- endif -%}

            {%- if desktop_img or mobile_img -%}
              <picture class="banner-picture{% if desktop_is_video %} medium-hide large-up-hide{% endif %}{% if mobile_is_video %} small-hide{% endif %}">
                {%- if desktop_img -%}
                  <source
                    media="(min-width: 750px)"
                    {% if is_first %}
                      srcset="{{ desktop_img | image_url: width: 750, format: 'webp' }} 750w, {{ desktop_img | image_url: width: 1200, format: 'webp' }} 1200w, {{ desktop_img | image_url: width: 1920, format: 'webp' }} 1920w"
                    {% else %}
                      data-srcset="{{ desktop_img | image_url: width: 750, format: 'webp' }} 750w, {{ desktop_img | image_url: width: 1200, format: 'webp' }} 1200w, {{ desktop_img | image_url: width: 1920, format: 'webp' }} 1920w"
                    {% endif %}
                    sizes="100vw"
                    width="{{ desktop_img.width }}"
                    height="{{ desktop_img.height }}"
                  >
                {%- endif -%}
                <img
                  {% if is_first %}
                    srcset="{{ mobile_img | image_url: width: 375, format: 'webp' }} 375w, {{ mobile_img | image_url: width: 750, format: 'webp' }} 750w"
                    src="{{ mobile_img | image_url: width: 750, format: 'webp' }}"
                    loading="eager"
                    fetchpriority="high"
                    decoding="sync"
                  {% else %}
                    data-srcset="{{ mobile_img | image_url: width: 375, format: 'webp' }} 375w, {{ mobile_img | image_url: width: 750, format: 'webp' }} 750w"
                    data-src="{{ mobile_img | image_url: width: 750, format: 'webp' }}"
                    loading="lazy"
                    decoding="async"
                  {% endif %}
                  sizes="100vw"
                  alt="{{ block.settings.alt_text | default: shop.name | escape }}"
                  class="media banner-img"
                  width="{{ mobile_img.width | default: 750 }}"
                  height="{{ mobile_img.height | default: 750 }}"
                >
              </picture>
            {%- endif -%}

            {%- if block.settings.link != blank -%}
              <a
                href="{{ block.settings.link }}"
                class="banner-carousel__link"
                aria-label="{{ block.settings.alt_text | default: shop.name | escape }}"
                {% unless is_first %}tabindex="-1"{% endunless %}
              ></a>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="banner-carousel__slide is-active">
            <div class="banner-carousel__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%}
        Dots are rendered server-side rather than injected by JS - injecting them
        after hydration would push the page down and cost a layout shift.
      {%- endcomment -%}
      {%- if section.settings.show_pagination and block_count > 1 -%}
        <div class="banner-carousel__dots">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="banner-carousel__dot{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </banner-carousel>
  </div>
</section>

{% schema %}
{
  "name": "Main Banner (Swiper)",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout Width",
      "default": "full-width",
      "options": [
        { "value": "full-width", "label": "Full width" },
        { "value": "page-width", "label": "Page width (container)" }
      ]
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Banner Border Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay_enable",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "select",
      "id": "autoplay_speed",
      "label": "Autoplay interval",
      "options": [
        { "value": "3", "label": "Every 3 seconds" },
        { "value": "5", "label": "Every 5 seconds" },
        { "value": "10", "label": "Every 10 seconds" }
      ],
      "default": "5"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "select",
          "id": "media_type_desktop",
          "label": "Desktop media",
          "info": "Choose whether to show image or video on desktop for this slide",
          "default": "image",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop Image",
          "visible_if": "{{ block.settings.media_type_desktop == 'image' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Desktop Video",
          "visible_if": "{{ block.settings.media_type_desktop == 'video' }}"
        },
        {
          "type": "select",
          "id": "media_type_mobile",
          "label": "Mobile media",
          "info": "Choose whether to show image or video on mobile for this slide",
          "default": "image",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Image",
          "visible_if": "{{ block.settings.media_type_mobile == 'image' }}"
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "Mobile Video",
          "visible_if": "{{ block.settings.media_type_mobile == 'video' }}"
        },
        {
          "type": "header",
          "content": "Video settings"
        },
        {
          "type": "checkbox",
          "id": "video_autoplay",
          "label": "Autoplay video",
          "info": "Requires 'Muted' to also be on - browsers block autoplay with sound",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "video_loop",
          "label": "Loop video",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "video_muted",
          "label": "Muted",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "video_controls",
          "label": "Show video controls",
          "default": false
        },
        { "type": "url", "id": "link", "label": "Slide Link" },
        { "type": "text", "id": "alt_text", "label": "Alt Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Main Banner (Swiper)",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
