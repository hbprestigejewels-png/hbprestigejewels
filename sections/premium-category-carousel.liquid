<script>
  (function () {
    if (customElements.get('category-carousel-component')) return;

    class CategoryCarousel extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('.category-carousel__track');
        this.prevBtn = this.querySelector('.category-carousel__nav--prev');
        this.nextBtn = this.querySelector('.category-carousel__nav--next');
        this.cards = Array.from(this.querySelectorAll('.category-carousel__card'));
        this.currentIndex = 0;
        this.totalCards = this.cards.length;
        this.isDragging = false;
        this.startX = 0;
        this.autoplayInterval = null;
        this.isAutoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.speed) || 3000;
      }

      connectedCallback() {
        if (this.totalCards === 0) return;
        this.updatePositions();
        this.setupEventListeners();
        if (this.isAutoplay && this.totalCards > 1) {
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }

      setupEventListeners() {
        if (this.prevBtn) {
          this.prevBtn.addEventListener('click', (e) => {
            e.preventDefault();
            this.prevSlide();
          });
        }
        if (this.nextBtn) {
          this.nextBtn.addEventListener('click', (e) => {
            e.preventDefault();
            this.nextSlide();
          });
        }

        const viewport = this.querySelector('.category-carousel__viewport');
        if (viewport && this.totalCards > 1) {
          viewport.addEventListener('mouseenter', () => this.stopAutoplay());
          viewport.addEventListener('mouseleave', () => {
            if (this.isAutoplay && this.totalCards > 1) this.startAutoplay();
          });

          // Drag listeners are bound once and the window-level move/end
          // listeners are attached only while a drag is actually in progress.
          // Previously a non-passive touchmove sat on `window` for the whole
          // session, so the browser had to call into JS before it could commit
          // *any* touch scroll frame anywhere on the page.
          this.boundDragMove = this.onDragMove.bind(this);
          this.boundDragEnd = this.onDragEnd.bind(this);

          viewport.addEventListener('mousedown', this.onDragStart.bind(this));
          viewport.addEventListener('touchstart', this.onDragStart.bind(this), { passive: true });
        }
      }

      onDragStart(e) {
        if (this.totalCards <= 1) return;
        this.isDragging = true;
        this.isTouch = e.type === 'touchstart';
        this.axisLocked = !this.isTouch; // a mouse drag is horizontal by definition
        this.startX = this.getClientX(e);
        this.startY = this.getClientY(e);
        if (this.track) this.track.classList.add('dragging');
        this.stopAutoplay();

        // A touch drag must NOT preventDefault here - doing so kills vertical
        // page scrolling for anyone whose finger lands on the carousel. The
        // axis is decided on the first move instead.
        if (!this.isTouch) e.preventDefault();

        this.attachDragListeners();
      }

      attachDragListeners() {
        window.addEventListener('mousemove', this.boundDragMove);
        window.addEventListener('touchmove', this.boundDragMove, { passive: false });
        window.addEventListener('mouseup', this.boundDragEnd);
        window.addEventListener('touchend', this.boundDragEnd);
        window.addEventListener('touchcancel', this.boundDragEnd);
      }

      detachDragListeners() {
        window.removeEventListener('mousemove', this.boundDragMove);
        window.removeEventListener('touchmove', this.boundDragMove, { passive: false });
        window.removeEventListener('mouseup', this.boundDragEnd);
        window.removeEventListener('touchend', this.boundDragEnd);
        window.removeEventListener('touchcancel', this.boundDragEnd);
      }

      onDragMove(e) {
        if (!this.isDragging || this.totalCards <= 1) return;

        // First move of a touch drag decides the axis: mostly-vertical means
        // the user is scrolling the page, so bail out and leave the gesture
        // alone entirely.
        if (!this.axisLocked) {
          const dx = Math.abs(this.getClientX(e) - this.startX);
          const dy = Math.abs(this.getClientY(e) - this.startY);
          if (dx < 6 && dy < 6) return; // not enough movement to judge yet
          if (dy > dx) {
            this.cancelDrag();
            return;
          }
          this.axisLocked = true;
        }

        e.preventDefault();
      }

      cancelDrag() {
        this.isDragging = false;
        this.axisLocked = false;
        if (this.track) this.track.classList.remove('dragging');
        this.detachDragListeners();
        if (this.isAutoplay && this.totalCards > 1) this.startAutoplay();
      }

      onDragEnd(e) {
        this.detachDragListeners();
        if (!this.isDragging || this.totalCards <= 1) {
          this.isDragging = false;
          return;
        }
        this.isDragging = false;
        this.axisLocked = false;
        if (this.track) this.track.classList.remove('dragging');

        const endX = this.getClientX(e);
        const diff = this.startX - endX;

        if (Math.abs(diff) > 50) {
          if (diff > 0) {
            this.nextSlide();
          } else {
            this.prevSlide();
          }
        }

        if (this.isAutoplay && this.totalCards > 1) {
          this.startAutoplay();
        }
      }

      getClientX(e) {
        if (e.type.includes('mouse')) return e.clientX;
        const touch = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0]);
        return touch ? touch.clientX : 0;
      }

      getClientY(e) {
        if (e.type.includes('mouse')) return e.clientY;
        const touch = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0]);
        return touch ? touch.clientY : 0;
      }

      nextSlide() {
        if (this.totalCards === 0) return;
        this.currentIndex = (this.currentIndex + 1) % this.totalCards;
        this.updatePositions();
      }

      prevSlide() {
        if (this.totalCards === 0) return;
        this.currentIndex = (this.currentIndex - 1 + this.totalCards) % this.totalCards;
        this.updatePositions();
      }

      updatePositions() {
        this.cards.forEach((card, idx) => {
          let position = idx - this.currentIndex;
          const half = this.totalCards / 2;
          if (position > half) position -= this.totalCards;
          if (position < -half) position += this.totalCards;
          card.setAttribute('data-position', position);
        });
      }

      startAutoplay() {
        this.stopAutoplay();
        if (this.totalCards <= 1) return;
        this.autoplayInterval = setInterval(() => this.nextSlide(), this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }
    }

    customElements.define('category-carousel-component', CategoryCarousel);
  })();
</script>
