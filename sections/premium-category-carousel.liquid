{% comment %}
  Section: 3D Category Carousel - 7 Front Collections with Proper Fading
  Compatible with Dawn theme
  Full width, customizable background image
{% endcomment %}

<div
  class="category-carousel-section"
  style="background-color: {{ section.settings.bg_color }}; position: relative; overflow: hidden;"
>
  {%- if section.settings.bg_image -%}
    <img
      src="{{ section.settings.bg_image | image_url: width: 1440, format: 'webp' }}"
      alt="Category Background"
      loading="lazy"
      decoding="async"
      width="1440"
      height="600"
      style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; pointer-events: none;"
    >
  {%- endif -%}
  <div class="category-carousel-container {% if section.settings.full_width %}full-width{% else %}page-width{% endif %}">
    <div class="category-carousel__header">
      {% if section.settings.title != blank %}
        <h2 class="category-carousel__title" style="color: {{ section.settings.title_color }};">
          {{ section.settings.title | escape }}
        </h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="category-carousel__description" style="color: {{ section.settings.description_color }};">
          {{ section.settings.description | escape }}
        </p>
      {% endif %}
    </div>

    <category-carousel-component
      data-autoplay="{{ section.settings.autoplay }}"
      data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
    >
      <div class="category-carousel__viewport">
        <div class="category-carousel__track">
          {% for block in section.blocks limit: 15 %}
            {% assign category = block.settings %}
            <a
              href="{{ category.url | default: '#' }}"
              class="category-carousel__card"
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <div class="category-carousel__image-wrapper">
                {% if category.image != blank %}
                  {% assign alt_text = category.title | default: category.image.alt | default: 'Jewellery Collection' | escape %}
                  {{
                    category.image
                    | image_url: width: 400, format: 'webp'
                    | image_tag:
                      loading: 'lazy',
                      decoding: 'async',
                      class: 'category-carousel__image',
                      sizes: '(max-width: 749px) 180px, (max-width: 990px) 220px, 300px',
                      widths: '200, 300, 400',
                      alt: alt_text
                  }}

                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: 'category-carousel__image-placeholder' }}
                {% endif %}
              </div>
              <div class="category-carousel__content">
                <h3 class="category-carousel__card-title">{{ category.title | default: 'Category' }}</h3>
                {% if category.subtitle != blank %}
                  <p class="category-carousel__card-subtitle">{{ category.subtitle }}</p>
                {% endif %}
              </div>
            </a>
          {% endfor %}
        </div>

        <button class="category-carousel__nav category-carousel__nav--prev" aria-label="Previous">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="category-carousel__nav category-carousel__nav--next" aria-label="Next">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </category-carousel-component>

    {% if section.settings.show_view_all %}
      <div class="category-carousel__viewall-wrap">
        <a
          href="{{ section.settings.view_all_url | default: '/collections/all' }}"
          class="category-carousel__viewall-btn"
          style="
            color: {{ section.settings.view_all_text_color }};
            border-color: {{ section.settings.view_all_border_color }};
            background: {{ section.settings.view_all_bg_color }};
          "
        >
          {{ section.settings.view_all_text | default: 'View All Categories' }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

