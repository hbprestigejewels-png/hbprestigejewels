{% style %}
.category-carousel-section {
  position: relative;
  width: 100%;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  overflow-x: clip;
}

.category-carousel-container {
  position: relative;
  width: 100%;
  margin: 0 auto;
  padding: 80px 20px;
}

.category-carousel-container.full-width {
  max-width: 100%;
  padding: 30px 0;
}

.category-carousel-container:not(.full-width) {
  max-width: 1400px;
  padding: 80px 20px;
}

.category-carousel__header {
  text-align: center;
  margin-bottom: 30px;
  padding: 0 20px;
}

.category-carousel__title {
  font-size: clamp(16px, 4vw, 22px);
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin: 0 0 12px;
}

.category-carousel__description {
  font-size: clamp(12px, 3vw, 14px);
  max-width: 650px;
  margin: 0 auto;
  line-height: 1.6;
}

.category-carousel__viewport {
  position: relative;
  max-width: 100%;
  margin: 0 auto;
  perspective: 2200px;
  perspective-origin: 50% 50%;
  overflow: visible;
  padding: 0px 0 0px;
}

category-carousel-component {
  display: block;
  width: 100%;
}

.category-carousel__track {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 500px;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.category-carousel__track.dragging {
  transition: none;
  cursor: grabbing;
}

.category-carousel__card {
  position: absolute;
  width: 280px;
  background: #ffffff;
  border-radius: 20px !important;
  overflow: hidden;
  box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.2);
  text-decoration: none;
  transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  will-change: transform, opacity;
  -webkit-backface-visibility: visible;
  backface-visibility: visible;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  cursor: pointer;
}

/* ======================================== */
/* 7 VISIBLE CARDS WITH PROPER OPACITY FADE */
/* ======================================== */

/* CENTER CARD - position 0 (fully opaque, largest) */
.category-carousel__card[data-position="0"] {
  transform: translateX(0) translateZ(160px) scale(1);
  z-index: 20;
  opacity: 1;
  box-shadow: 0 30px 50px -15px rgba(0, 0, 0, 0.35);
}

/* FIRST LEFT & RIGHT - position -1 and 1 (slightly faded) */
.category-carousel__card[data-position="-1"] {
  transform: translateX(-340px) translateZ(60px) scale(0.88) rotateY(20deg);
  z-index: 18;
  opacity: 0.85;
}
.category-carousel__card[data-position="1"] {
  transform: translateX(340px) translateZ(60px) scale(0.88) rotateY(-20deg);
  z-index: 18;
  opacity: 0.85;
}

/* SECOND LEFT & RIGHT - position -2 and 2 (more faded) */
.category-carousel__card[data-position="-2"] {
  transform: translateX(-600px) translateZ(-20px) scale(0.75) rotateY(38deg);
  z-index: 14;
  opacity: 0.65;
}
.category-carousel__card[data-position="2"] {
  transform: translateX(600px) translateZ(-20px) scale(0.75) rotateY(-38deg);
  z-index: 14;
  opacity: 0.65;
}

/* THIRD LEFT & RIGHT - position -3 and 3 (heavily faded, almost transparent) */
.category-carousel__card[data-position="-3"] {
  transform: translateX(-820px) translateZ(-120px) scale(0.62) rotateY(52deg);
  z-index: 8;
  opacity: 0.4;
}
.category-carousel__card[data-position="3"] {
  transform: translateX(820px) translateZ(-120px) scale(0.62) rotateY(-52deg);
  z-index: 8;
  opacity: 0.4;
}

/* CARDS BEYOND POSITION 3 - completely hidden (not visible) */
.category-carousel__card[data-position="-4"],
.category-carousel__card[data-position="4"],
.category-carousel__card[data-position="-5"],
.category-carousel__card[data-position="5"],
.category-carousel__card[data-position="-6"],
.category-carousel__card[data-position="6"] {
  opacity: 0;
  pointer-events: none;
  transform: translateX(1200px) translateZ(-400px) scale(0.5);
  visibility: hidden;
}

.category-carousel__card[data-position="-4"],
.category-carousel__card[data-position="-5"],
.category-carousel__card[data-position="-6"] {
  transform: translateX(-1200px) translateZ(-400px) scale(0.5);
}

.category-carousel__image-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 125%;
  overflow: hidden;
  background: #f0f0f0;
}

.category-carousel__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.category-carousel__card:hover .category-carousel__image {
  transform: scale(1.06);
}

.category-carousel__image-placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: #e8e8e8;
}

.category-carousel__content {
  padding: 16px 12px;
  text-align: center;
  background: #ffffff;
}

.category-carousel__card-title {
  font-family: inherit;
  font-style: italic;
  font-size: 19px;
  font-weight: 700;
  color: #111111;
  -webkit-text-stroke: 0.35px #111111;
  background: transparent;
  margin: 0;
  letter-spacing: 0.5px;
  text-shadow: none !important;
}

.category-carousel__card-subtitle {
  font-size: 12px;
  color: #777777;
  margin: 5px 0 0;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Navigation buttons */
.category-carousel__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 35;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
  transition: all 0.3s ease;
}

.category-carousel__nav:hover {
  background: #000000;
  transform: translateY(-50%) scale(1.08);
}

.category-carousel__nav:hover svg {
  stroke: white;
}

.category-carousel__nav svg {
  width: 22px;
  height: 22px;
  stroke: #111;
  transition: stroke 0.25s;
}

.category-carousel__nav--prev {
  left: 25px;
}
.category-carousel__nav--next {
  right: 25px;
}

/* View All button */
.category-carousel__viewall-wrap {
  text-align: center;
  margin-top: 50px;
}

.category-carousel__viewall-btn {
  display: inline-block;
  padding: 12px 32px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  text-decoration: none;
  border: 2px solid;
  border-radius: 50px;
  transition: all 0.3s ease;
}

.category-carousel__viewall-btn:hover {
  opacity: 0.85;
  transform: translateY(-2px);
}

/* ========== RESPONSIVE ========== */
