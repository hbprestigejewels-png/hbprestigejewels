<section class="video-url-banner" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">

<div class="video-wrapper">

  {% if section.settings.video_url != blank %}
  <video
    class="video-banner"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="{% if section.settings.poster != blank %}{{ section.settings.poster | image_url: width: 1200, format: 'webp' }}{% endif %}"
  >
    <source src="{{ section.settings.video_url }}" type="video/mp4">
  </video>
  {% endif %}

  <div class="video-overlay">
    <div class="video-content">
      <h2 class="video-heading">
        {{ section.settings.heading }}
      </h2>
    </div>
  </div>

</div>

</section>


<style>

.video-url-banner{
width:100%;
position:relative;
overflow:hidden;
}

.video-wrapper{
position:relative;
width:100%;
}

.video-banner{
width:100%;
height:auto;
display:block;
object-fit:cover;
}

.video-overlay{
position:absolute;
top:0;
left:0;
width:100%;
height:100%;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
padding:20px;
}

.video-heading{
color:{{ section.settings.text_color }};
font-size:{{ section.settings.text_size }}px;
font-weight:700;
letter-spacing:1px;
margin:0;
}

@media screen and (max-width:749px){

.video-heading{
font-size:{{ section.settings.mobile_text_size }}px;
}

}

</style>


{% schema %}
{
"name": "Video Banner (MP4 URL)",
"settings": [

{
"type": "text",
"id": "video_url",
"label": "MP4 Video URL"
},

{
"type": "image_picker",
"id": "poster",
"label": "Poster Image"
},

{
"type": "text",
"id": "heading",
"label": "Heading Text",
"default": "BECAUSE YOU DESERVE TO SHINE!"
},

{
"type": "color",
"id": "text_color",
"label": "Text Color",
"default": "#ffffff"
},

{
"type": "range",
"id": "text_size",
"label": "Desktop Text Size",
"min": 20,
"max": 80,
"step": 2,
"default": 40
},

{
"type": "range",
"id": "mobile_text_size",
"label": "Mobile Text Size",
"min": 14,
"max": 40,
"step": 2,
"default": 22
},

{
"type": "range",
"id": "padding_top",
"label": "Top Padding",
"min": 0,
"max": 120,
"step": 5,
"default": 0
},

{
"type": "range",
"id": "padding_bottom",
"label": "Bottom Padding",
"min": 0,
"max": 120,
"step": 5,
"default": 0
}

],

"presets":[
{
"name":"Video Banner (MP4 URL)"
}
]
}
{% endschema %}