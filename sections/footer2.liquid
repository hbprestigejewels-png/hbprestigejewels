{% style %}
  .custom-footer{
    --accent: #c9a15a;
    --accent-2: #e6c988;
    --accent-light: #f4e7d0;
    --text-dark: #1c1c1c;
    position: relative;
    background: linear-gradient(180deg, #fff6ef 0%, #fff1ea 100%);
    padding-top: 60px;
    font-family: Poppins, Arial, sans-serif;
    padding-right: 24px;
    padding-left: 24px;
    border-top: 1px solid #f0dcc8;
    overflow: hidden;
  }

  .custom-footer::before,
  .custom-footer::after{
    content: "";
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201,161,90,0.16) 0%, rgba(201,161,90,0) 70%);
    pointer-events: none;
    z-index: 0;
  }
  .custom-footer::before{
    width: 340px; height: 340px;
    top: -140px; left: -100px;
  }
  .custom-footer::after{
    width: 420px; height: 420px;
    bottom: -180px; right: -140px;
  }

  /* ===== FLOATING DECOR: moves across ENTIRE footer ===== */
  .footer-float-decor{
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .float-item{
    position: absolute;
    filter: drop-shadow(0 6px 12px rgba(201,161,90,0.3));
    will-change: transform;
  }

  .float-custom-img{
    object-fit: contain;
    display: block;
  }

  /* Each item travels a big loop across the whole footer height/width */
  .float-diamond.diamond-1{
    width: 30px; height: 30px;
    top: 6%;
    left: 8%;
    opacity: 0.55;
    animation: travelA 26s ease-in-out infinite, spinItem 10s linear infinite;
  }
  .float-diamond.diamond-2{
    width: 20px; height: 20px;
    top: 55%;
    left: 20%;
    opacity: 0.45;
    animation: travelB 22s ease-in-out infinite 2s, spinItem 8s linear infinite reverse;
  }
  .float-diamond.diamond-3{
    width: 24px; height: 24px;
    top: 15%;
    right: 12%;
    opacity: 0.5;
    animation: travelC 30s ease-in-out infinite 1s, spinItem 12s linear infinite;
  }

  .float-ring.ring-1{
    width: 60px; height: 60px;
    top: 40%;
    left: 42%;
    opacity: 0.4;
    animation: travelD 34s ease-in-out infinite;
  }
  .float-ring.ring-2{
    width: 46px; height: 46px;
    top: 70%;
    right: 22%;
    opacity: 0.45;
    animation: travelE 28s ease-in-out infinite 3s;
  }

  .float-store.store-1{
    width: 30px; height: 30px;
    bottom: 10%;
    left: 45%;
    opacity: 0.4;
    animation: travelF 24s ease-in-out infinite 1.5s;
  }

  /* Distinct travel paths covering large % of footer area */
  @keyframes travelA{
    0%   { transform: translate(0, 0) rotate(0deg); }
    25%  { transform: translate(60vw, 40px) rotate(10deg); }
    50%  { transform: translate(70vw, 160px) rotate(-6deg); }
    75%  { transform: translate(20vw, 220px) rotate(8deg); }
    100% { transform: translate(0, 0) rotate(0deg); }
  }

  @keyframes travelB{
    0%   { transform: translate(0, 0); }
    30%  { transform: translate(-15vw, 90px); }
    60%  { transform: translate(40vw, -30px); }
    100% { transform: translate(0, 0); }
  }

  @keyframes travelC{
    0%   { transform: translate(0, 0) rotate(0deg); }
    35%  { transform: translate(-50vw, 60px) rotate(-12deg); }
    70%  { transform: translate(-30vw, 200px) rotate(10deg); }
    100% { transform: translate(0, 0) rotate(0deg); }
  }

  @keyframes travelD{
    0%   { transform: translate(0, 0) rotate(0deg) scale(1); }
    25%  { transform: translate(-25vw, -60px) rotate(4deg) scale(1.05); }
    50%  { transform: translate(20vw, -140px) rotate(-4deg) scale(0.95); }
    75%  { transform: translate(30vw, 40px) rotate(3deg) scale(1.05); }
    100% { transform: translate(0, 0) rotate(0deg) scale(1); }
  }

  @keyframes travelE{
    0%   { transform: translate(0, 0) rotate(0deg); }
    40%  { transform: translate(-35vw, -80px) rotate(-8deg); }
    75%  { transform: translate(-10vw, 60px) rotate(6deg); }
    100% { transform: translate(0, 0) rotate(0deg); }
  }

  @keyframes travelF{
    0%   { transform: translate(0, 0); }
    30%  { transform: translate(25vw, -140px); }
    65%  { transform: translate(-20vw, -60px); }
    100% { transform: translate(0, 0); }
  }

  @keyframes spinItem{
    from{ transform: rotate(0deg); }
    to{ transform: rotate(360deg); }
  }

  .page-width{
    position: relative;
    z-index: 1;
  }

  .footer-grid{
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 48px;
    padding-bottom: 40px;
  }

  [data-reveal]{
    opacity: 0;
    transform: translateY(24px);
    transition: opacity .6s cubic-bezier(.4,0,.2,1), transform .6s cubic-bezier(.4,0,.2,1);
    transition-delay: calc(var(--delay, 0) * 90ms);
  }
  [data-reveal].is-visible{
    opacity: 1;
    transform: translateY(0);
  }

  .footer-logo{
    max-width: 160px;
    margin-bottom: 18px;
    transition: transform .35s ease, filter .35s ease;
  }
  .footer-logo:hover{
    transform: scale(1.04) rotate(-1deg);
    filter: drop-shadow(0 6px 10px rgba(201,161,90,0.35));
  }

  .footer-text{
    font-size: 14px;
    color: #444;
    line-height: 1.8;
    margin: 0 0 20px;
  }

  .footer-contact{
    margin-top: 6px;
    font-size: 13px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-contact-line{
    display: flex;
    align-items: center;
    gap: 10px;
    color: #333;
    transition: transform .25s ease, color .25s ease;
  }
  .footer-contact-line:hover{
    color: var(--accent);
    transform: translateX(4px);
  }

  .footer-contact-icon{
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(145deg, var(--accent-light), #ffffff);
    box-shadow:
      0 2px 5px rgba(201,161,90,0.25),
      inset 0 1px 1px rgba(255,255,255,0.9),
      inset 0 -2px 3px rgba(201,161,90,0.25);
    transition: transform .35s cubic-bezier(.34,1.56,.64,1), box-shadow .35s ease, background .35s ease;
    transform-style: preserve-3d;
  }
  .footer-contact-icon svg{
    width: 14px;
    height: 14px;
    fill: var(--accent);
    transition: fill .3s ease;
  }
  .footer-contact-line:hover .footer-contact-icon{
    background: linear-gradient(145deg, var(--accent), var(--accent-2));
    transform: translateY(-3px) rotateX(15deg) rotateY(-15deg) scale(1.08);
    box-shadow:
      0 8px 14px rgba(201,161,90,0.4),
      inset 0 1px 1px rgba(255,255,255,0.5);
  }
  .footer-contact-line:hover .footer-contact-icon svg{
    fill: #fff;
  }

  .footer-col h4{
    position: relative;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-dark);
    margin: 0 0 24px;
    padding-bottom: 12px;
    letter-spacing: .3px;
  }

  .footer-col h4::after{
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 32px;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    background-size: 200% 100%;
    transition: width .35s ease;
    animation: shimmerLine 2.5s linear infinite;
  }
  .footer-col:hover h4::after{
    width: 52px;
  }

  @keyframes shimmerLine{
    0%{ background-position: 0% 0; }
    100%{ background-position: 200% 0; }
  }

  .footer-col ul{
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-col ul li{
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 13px;
  }

  .footer-li-icon{
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--accent-light);
    opacity: 0;
    transform: translateX(-6px) scale(.7);
    transition: opacity .25s ease, transform .3s cubic-bezier(.34,1.56,.64,1), background .25s ease;
  }
  .footer-li-icon svg{
    width: 8px;
    height: 8px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .footer-col ul li a{
    text-decoration: none;
    color: #444;
    font-size: 13.5px;
    transition: color .25s ease, margin-left .25s ease;
  }

  .footer-col ul li:hover .footer-li-icon{
    opacity: 1;
    transform: translateX(0) scale(1);
    background: var(--accent);
  }
  .footer-col ul li:hover .footer-li-icon svg{
    stroke: #fff;
  }
  .footer-col ul li:hover a{
    color: var(--accent);
    margin-left: 2px;
  }

  .newsletter-desc{
    font-size: 13px;
    line-height: 1.7;
    color: #444;
    margin: 0 0 20px;
  }

  .newsletter-box{
    display: flex;
    align-items: center;
    border: 1.5px solid var(--text-dark);
    max-width: 420px;
    border-radius: 30px !important;
    overflow: hidden;
    background: #fff;
    padding-left: 14px;
    transition: border-color .3s ease, box-shadow .3s ease;
  }

  .newsletter-box:focus-within{
    border-color: var(--accent);
    box-shadow: 0 0 0 4px rgba(201,161,90,0.18), 0 6px 16px rgba(201,161,90,0.15);
  }

  .newsletter-icon{
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .newsletter-icon svg{
    width: 16px;
    height: 16px;
    fill: #999;
    transition: fill .25s ease;
  }
  .newsletter-box:focus-within .newsletter-icon svg{
    fill: var(--accent);
  }

  .newsletter-input{
    flex: 1;
    border: none;
    padding: 13px 14px;
    font-size: 13px;
    outline: none;
    background: transparent;
    color: #222;
  }

  .newsletter-input:focus,
.newsletter-input:focus-visible,
.newsletter-input:active {
  outline: none !important;
  border: none !important;
  box-shadow: none !important;
}

  .newsletter-input::placeholder{
    color: #999;
  }

  .newsletter-btn{
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--text-dark);
    color: #fff;
    border: none;
    padding: 13px 22px;
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: .3px;
    cursor: pointer;
    transition: background .35s ease, padding-right .3s ease;
    white-space: nowrap;
    overflow: hidden;
  }

  .newsletter-btn::before{
    content: "";
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.35), transparent);
    transform: skewX(-20deg);
    transition: left .6s ease;
  }
  .newsletter-btn:hover::before{
    left: 130%;
  }

  .newsletter-btn-icon{
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .newsletter-btn-icon svg{
    width: 14px;
    height: 14px;
    fill: #fff;
    transform: translateX(-4px);
    opacity: 0;
    transition: transform .3s ease, opacity .3s ease;
  }

  .newsletter-btn:hover{
    background: var(--accent);
    padding-right: 18px;
  }
  .newsletter-btn:hover .newsletter-btn-icon svg{
    transform: translateX(0);
    opacity: 1;
  }

  .newsletter-success{
    font-size: 13.5px;
    font-weight: 500;
    color: #2e7d32;
    margin-top: 12px;
    animation: fadeIn .4s ease;
  }

  .newsletter-error{
    font-size: 13.5px;
    font-weight: 500;
    color: #c0392b;
    margin-top: 12px;
    animation: fadeIn .4s ease;
  }

  @keyframes fadeIn{
    from{ opacity: 0; transform: translateY(-4px); }
    to{ opacity: 1; transform: translateY(0); }
  }

  .footer-bottom{
    position: relative;
    z-index: 1;
    border-top: 1px solid #f0dcc8;
    margin-top: 10px;
    padding: 18px 0;
    background: #fff9f4;
  }

  .footer-bottom-inner{
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .copyright{
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    color: #555;
    text-align: center;
    line-height: 1.6;
    padding: 10px 0;
  }

  .copyright a{
    color: var(--text-dark);
    text-decoration: none;
    font-weight: 600;
  }

  .copyright a:hover{
    color: var(--accent);
    text-decoration: underline;
  }

  .payment-icons img{
    max-width: 280px;
    opacity: 0;
    transform: translateY(10px);
    animation: fadeIn .6s ease .2s forwards;
  }

  @media (max-width: 767px){
    .copyright{
      font-family: 'Roboto', sans-serif;
      font-size: 11px;
    }

    .custom-footer{
      padding-top: 44px;
      padding-left: 18px;
      padding-right: 18px;
    }
    .custom-footer::before,
    .custom-footer::after{
      display: none;
    }

    .float-item{
      display: none;
    }

    .footer-grid{
      grid-template-columns: 1fr;
      gap: 36px;
      padding-bottom: 30px;
    }

    .footer-bottom-inner{
      flex-direction: column;
      gap: 12px;
    }

    .newsletter-box{
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce){
    [data-reveal]{
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .footer-col h4::after{ animation: none; }
    .float-item{
      animation: none !important;
    }
  }
{% endstyle %}

<footer class="custom-footer">
  <!-- FLOATING DECORATIVE ELEMENTS -->
  <div class="footer-float-decor" aria-hidden="true">

    {% if section.settings.show_default_floating_decor %}
      <!-- Shared gradients/filters -->
      <svg width="0" height="0" style="position:absolute">
        <defs>
          <linearGradient id="goldGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#f5deb3"/>
            <stop offset="45%" stop-color="#e6c988"/>
            <stop offset="100%" stop-color="#a3812f"/>
          </linearGradient>
          <linearGradient id="goldGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#fff6e0"/>
            <stop offset="50%" stop-color="#c9a15a"/>
            <stop offset="100%" stop-color="#8a6a28"/>
          </linearGradient>
          <linearGradient id="diamondFacetLight" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.9"/>
            <stop offset="100%" stop-color="#dce9ff" stop-opacity="0.2"/>
          </linearGradient>
          <radialGradient id="ringMetal" cx="35%" cy="30%" r="70%">
            <stop offset="0%" stop-color="#fff6e0"/>
            <stop offset="55%" stop-color="#e6c988"/>
            <stop offset="100%" stop-color="#9c7a30"/>
          </radialGradient>
        </defs>
      </svg>

      <!-- REALISTIC DIAMOND 1 -->
      <svg class="float-item float-diamond diamond-1" viewBox="0 0 100 100">
        <polygon points="50,4 68,26 50,26 32,26" fill="url(#diamondFacetLight)"/>
        <polygon points="50,4 68,26 82,30 50,30" fill="url(#goldGrad2)" opacity="0.9"/>
        <polygon points="50,4 32,26 18,30 50,30" fill="url(#goldGrad1)" opacity="0.85"/>
        <polygon points="18,30 82,30 50,96" fill="url(#goldGrad2)"/>
        <polygon points="18,30 50,30 40,55" fill="url(#diamondFacetLight)" opacity="0.6"/>
        <polygon points="82,30 50,30 60,55" fill="url(#goldGrad1)" opacity="0.7"/>
        <polygon points="40,55 60,55 50,96" fill="url(#diamondFacetLight)" opacity="0.5"/>
        <polygon points="18,30 40,55 50,30" fill="url(#goldGrad2)" opacity="0.6"/>
        <polygon points="82,30 60,55 50,30" fill="url(#goldGrad1)" opacity="0.6"/>
        <path d="M50 4 L18 30 L82 30 Z" fill="none" stroke="#fff" stroke-opacity="0.4" stroke-width="0.6"/>
        <circle cx="38" cy="18" r="3" fill="#ffffff" opacity="0.85"/>
      </svg>

      <!-- REALISTIC DIAMOND 2 (smaller) -->
      <svg class="float-item float-diamond diamond-2" viewBox="0 0 100 100">
        <polygon points="50,4 68,26 50,26 32,26" fill="url(#diamondFacetLight)"/>
        <polygon points="50,4 68,26 82,30 50,30" fill="url(#goldGrad2)" opacity="0.9"/>
        <polygon points="50,4 32,26 18,30 50,30" fill="url(#goldGrad1)" opacity="0.85"/>
        <polygon points="18,30 82,30 50,96" fill="url(#goldGrad2)"/>
        <polygon points="18,30 50,30 40,55" fill="url(#diamondFacetLight)" opacity="0.6"/>
        <polygon points="82,30 50,30 60,55" fill="url(#goldGrad1)" opacity="0.7"/>
        <polygon points="40,55 60,55 50,96" fill="url(#diamondFacetLight)" opacity="0.5"/>
        <circle cx="38" cy="18" r="3" fill="#ffffff" opacity="0.8"/>
      </svg>

      <!-- REALISTIC DIAMOND 3 -->
      <svg class="float-item float-diamond diamond-3" viewBox="0 0 100 100">
        <polygon points="50,4 68,26 50,26 32,26" fill="url(#diamondFacetLight)"/>
        <polygon points="50,4 68,26 82,30 50,30" fill="url(#goldGrad1)" opacity="0.9"/>
        <polygon points="50,4 32,26 18,30 50,30" fill="url(#goldGrad2)" opacity="0.85"/>
        <polygon points="18,30 82,30 50,96" fill="url(#goldGrad1)"/>
        <polygon points="18,30 50,30 40,55" fill="url(#diamondFacetLight)" opacity="0.55"/>
        <polygon points="82,30 50,30 60,55" fill="url(#goldGrad2)" opacity="0.6"/>
        <circle cx="38" cy="18" r="2.6" fill="#ffffff" opacity="0.8"/>
      </svg>

      <!-- HAND WITH RING (realistic-ish line-art ring on finger) -->
      <svg class="float-item float-ring ring-1" viewBox="0 0 120 120">
        <!-- finger -->
        <path d="M50 118 Q46 90 48 60 Q49 42 60 40 Q71 42 72 60 Q74 90 70 118 Z"
              fill="#f2d7b8" stroke="#dbb98d" stroke-width="1"/>
        <!-- knuckle shading -->
        <ellipse cx="60" cy="100" rx="11" ry="6" fill="#e8c39e" opacity="0.6"/>
        <!-- ring band -->
        <ellipse cx="60" cy="55" rx="15" ry="9" fill="none" stroke="url(#ringMetal)" stroke-width="6"/>
        <!-- ring gem (diamond top) -->
        <polygon points="60,32 68,42 60,42 52,42" fill="url(#diamondFacetLight)"/>
        <polygon points="52,42 68,42 60,58" fill="url(#goldGrad2)"/>
        <polygon points="52,42 60,42 57,50" fill="url(#diamondFacetLight)" opacity="0.6"/>
        <polygon points="68,42 60,42 63,50" fill="url(#goldGrad1)" opacity="0.6"/>
        <circle cx="56" cy="37" r="1.6" fill="#fff" opacity="0.9"/>
      </svg>

      <!-- SIMPLE RING (band + gem only, floats independently) -->
      <svg class="float-item float-ring ring-2" viewBox="0 0 100 100">
        <ellipse cx="50" cy="62" rx="30" ry="18" fill="none" stroke="url(#ringMetal)" stroke-width="7"/>
        <polygon points="50,20 62,34 50,34 38,34" fill="url(#diamondFacetLight)"/>
        <polygon points="38,34 62,34 50,58" fill="url(#goldGrad2)"/>
        <polygon points="38,34 50,34 45,46" fill="url(#diamondFacetLight)" opacity="0.6"/>
        <polygon points="62,34 50,34 55,46" fill="url(#goldGrad1)" opacity="0.6"/>
        <circle cx="43" cy="26" r="2.2" fill="#fff" opacity="0.85"/>
      </svg>

      <!-- STORE ICON -->
      <svg class="float-item float-store store-1" viewBox="0 0 24 24">
        <path fill="url(#goldGrad2)" d="M20 4H4v2h16V4zm1 10v-2l-1-5H4l-1 5v2h1v6h10v-6h4v6h2v-6h1zm-9 4H6v-4h6v4z"/>
      </svg>
    {% endif %}

    {% comment %} ---------- MERCHANT-ADDED FLOATING IMAGES (from theme editor blocks) ---------- {% endcomment %}
    {% for block in section.blocks %}
      {% if block.type == 'floating_image' and block.settings.image != blank %}
        {% assign fi_duration = block.settings.duration | default: 24 %}
        {% assign fi_spin_duration = fi_duration | times: 0.4 | round %}
        <img
          class="float-item float-custom-img"
          src="{{ block.settings.image | image_url: width: 400 }}"
          alt="{{ block.settings.alt_text | escape }}"
          loading="lazy"
          decoding="async"
          width="{{ block.settings.size }}"
          height="{{ block.settings.size }}"
          style="
            width: {{ block.settings.size }}px;
            height: {{ block.settings.size }}px;
            top: {{ block.settings.top_position }}%;
            left: {{ block.settings.left_position }}%;
            opacity: {{ block.settings.opacity | divided_by: 100.0 }};
            {% if block.settings.animation_path != 'none' %}
              animation: travel{{ block.settings.animation_path }} {{ fi_duration }}s ease-in-out infinite {{ block.settings.delay }}s
              {% if block.settings.spin %}, spinItem {{ fi_spin_duration }}s linear infinite{% endif %};
            {% elsif block.settings.spin %}
              animation: spinItem {{ fi_spin_duration }}s linear infinite;
            {% endif %}
          "
          {{ block.shopify_attributes }}
        >
      {% endif %}
    {% endfor %}
  </div>

  <div class="page-width">
    <div class="footer-grid">
      <!-- LOGO + ABOUT -->
      <div class="footer-col footer-about" data-reveal>
        {% if section.settings.footer_logo != blank %}
          <img
            src="{{ section.settings.footer_logo | image_url: width: 200 }}"
            class="footer-logo"
            alt="{{ shop.name }}"
            loading="lazy"
            decoding="async"
            width="200"
            height="80"
          >
        {% endif %}

        <p class="footer-text">
          {{ section.settings.about_text }}
        </p>

        <p class="footer-contact">
          <span class="footer-contact-line">
            <span class="footer-contact-icon">
              <svg viewBox="0 0 24 24">
                <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.3 1.1L6.6 10.8z"/>
              </svg>
            </span>
            {{ section.settings.phone }}
          </span>
          <span class="footer-contact-line">
            <span class="footer-contact-icon">
              <svg viewBox="0 0 24 24">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm0 2v.01L12 13 20 6.01V6H4zm16 2.24-7.42 6.19a1 1 0 0 1-1.16 0L4 8.24V18h16V8.24z"/>
              </svg>
            </span>
            {{ section.settings.email }}
          </span>
        </p>
      </div>

      <!-- COMPANY -->
      <div class="footer-col" data-reveal style="--delay:1">
        <h4>Our Company</h4>
        <ul>
          {% for link in linklists[section.settings.company_menu].links %}
            <li>
              <span class="footer-li-icon">
                <svg viewBox="0 0 24 24">
                  <path d="M9 6l6 6-6 6"/>
                </svg>
              </span>
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>

      <!-- CUSTOMER SERVICE -->
      <div class="footer-col" data-reveal style="--delay:2">
        <h4>Customer Service</h4>
        <ul>
          {% for link in linklists[section.settings.service_menu].links %}
            <li>
              <span class="footer-li-icon">
                <svg viewBox="0 0 24 24">
                  <path d="M9 6l6 6-6 6"/>
                </svg>
              </span>
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>

      <!-- NEWSLETTER -->
      <div class="footer-col newsletter" data-reveal style="--delay:3">
        <h4>Subscribe to HB Prestige</h4>

        <p class="newsletter-desc">
          Get updates on new launches, exclusive deals, and styling tips delivered to your inbox.
        </p>

        {% form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <div class="newsletter-box">
            <span class="newsletter-icon">
              <svg viewBox="0 0 24 24">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm0 2v.01L12 13 20 6.01V6H4zm16 2.24-7.42 6.19a1 1 0 0 1-1.16 0L4 8.24V18h16V8.24z"/>
              </svg>
            </span>
            <input
              type="email"
              name="contact[email]"
              class="newsletter-input"
              placeholder="Email address"
              required
            >
            <button type="submit" class="newsletter-btn">
              <span>Subscribe</span>
              <span class="newsletter-btn-icon">
                <svg viewBox="0 0 24 24">
                  <path d="M2 21l21-9L2 3v7l15 2-15 2z"/>
                </svg>
              </span>
            </button>
          </div>

          {% if form.posted_successfully? %}
            <p class="newsletter-success">✓ Thank you for subscribing!</p>
          {% endif %}

          {% if form.errors %}
            <p class="newsletter-error">{{ form.errors | default_errors }}</p>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>

  <!-- BOTTOM -->
  <div class="footer-bottom">
    <div class="page-width footer-bottom-inner">
      <div class="copyright">
        © {{ 'now' | date: '%Y' }}
        {{ shop.name }}. All Rights Reserved. Designed and developed by CRK Info
      </div>

      <div class="payment-icons">
        {% if section.settings.payment_icons != blank %}
          <img src="{{ section.settings.payment_icons | image_url: width: 300 }}" alt="Payment methods" loading="lazy" decoding="async" width="300" height="40">
        {% endif %}
      </div>
    </div>
  </div>
</footer>


<script>
  (function () {
    function initFooterReveal(root) {
      const footer = (root || document).querySelector('.custom-footer');
      if (!footer || footer.dataset.revealInit === 'true') return;
      footer.dataset.revealInit = 'true';

      const items = footer.querySelectorAll('[data-reveal]');
      if (!items.length) return;

      if (!('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );

      items.forEach((el) => observer.observe(el));
    }

    document.addEventListener('DOMContentLoaded', () => initFooterReveal(document));
    document.addEventListener('shopify:section:load', (e) => initFooterReveal(e.target));
  })();
</script>

