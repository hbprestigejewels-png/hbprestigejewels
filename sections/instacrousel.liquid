{% style %}
/* queensmith-gallery.css */
.queensmith-gallery-section {
  padding: 5rem 0;
  overflow: hidden;
}

@media screen and (min-width: 750px) {
  .queensmith-gallery-section {
    padding: 2rem 0;
  }
}

.queensmith-header {
  margin-bottom: 3rem;
}

@media screen and (min-width: 750px) {
  .queensmith-header {
    margin-bottom: 0rem;
  }
}

.queensmith-header__title {
  margin: 0;
  font-family: var(--font-heading-family);
  font-style: var(--font-heading-style);
  font-weight: var(--font-heading-weight);
  letter-spacing: calc(var(--font-heading-scale) * 0.06rem);
  line-height: 1.2;
  text-align: center;
  padding-bottom: 30px;
}

/* Carousel Styles */
.queensmith-carousel-container {
  margin-bottom: 3rem;
  width: 100%;
  overflow: clip;
}

.queensmith-auto-carousel {
  display: flex;
  gap: 1.5rem;
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.queensmith-auto-carousel::-webkit-scrollbar {
  display: none;
}

.queensmith-auto-carousel__group {
  display: flex;
  gap: 1.5rem;
  flex-shrink: 0;
  will-change: transform;
  contain: layout paint;
  animation: queensmith-scroll 90s linear infinite;
}

/* Pause animation on hover for better UX */
.queensmith-auto-carousel:hover .queensmith-auto-carousel__group {
  animation-play-state: paused;
}

@keyframes queensmith-scroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-100%);
  }
}

.queensmith-card-wrapper {
  width: 200px;
  flex-shrink: 0;
}

.queensmith-card {
  position: relative;
  border-radius:20px !important;
  overflow: hidden;
  margin-Top:16px;
  background-color: rgb(var(--color-background));
  width: 200px;
  height: 300px;
  box-shadow: 0 0.4rem 1.2rem rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.queensmith-card:hover {
  margin-Top:16px;
  transform: translateY(-0.5rem);
  box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.12);
}

.queensmith-card__image {
  width: 200px;
  height: 300px;
  object-fit: cover;
  display: block;
}

.queensmith-placeholder {
  width: 200px;
  height: 300px;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.queensmith-card__handle {
  position: absolute;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 245, 235, 0.95);
  color: rgb(var(--color-foreground));
  font-size: 1.2rem;
  line-height: 1;
  padding: 0.8rem 1.5rem;
  font-family: var(--font-body-family);
  border-radius: 10rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 180px;
  box-shadow: 0 0.2rem 0.4rem rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(2px);
  font-weight: 500;
  letter-spacing: 0.03em;
  pointer-events: none;
}

/* Social Proof Tag */
.queensmith-social-tag {
  display: flex;
  justify-content: center;
  margin: 3rem 0 2rem;
}

.queensmith-social-tag__wrapper {
  display: inline-flex;
  align-items: center;
  gap: 1rem;
  background: rgba(var(--color-foreground), 0.05);
  backdrop-filter: blur(4px);
  padding: 0.5rem 2rem 0.5rem 0.8rem;
  border-radius: 10rem;
  box-shadow: 0 0.2rem 0.6rem rgba(0, 0, 0, 0.05);
}

.queensmith-avatar-stack {
  display: flex;
  align-items: center;
}

.queensmith-avatar {
  width: 3rem;
  height: 3rem;
  border-radius: 50%;
  border: 2px solid rgb(var(--color-background));
  overflow: hidden;
  background-color: rgb(var(--color-background));
  box-shadow: 0 0.2rem 0.4rem rgba(0, 0, 0, 0.1);
}

.queensmith-avatar img,
.queensmith-avatar__placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.queensmith-avatar--overlap {
  margin-left: -1rem;
}

.queensmith-social-tag__text {
  font-size: 1.2rem;
  font-weight: 500;
  color: rgb(var(--color-foreground));
  letter-spacing: 0.03em;
  white-space: nowrap;
}

@media screen and (max-width: 480px) {
  .queensmith-social-tag__text {
    font-size: 1rem;
    white-space: normal;
    text-align: left;
  }

  .queensmith-social-tag__wrapper {
    padding-right: 1.2rem;
    max-width: 90%;
  }
}

/* Button */
.queensmith-button-wrapper {
  display: flex;
  justify-content: center;
  margin-top: 3rem;
}

.queensmith-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgb(var(--color-button));
  color: rgb(var(--color-button-text));
  font-family: var(--font-body-family);
  font-size: 1.4rem;
  font-weight: 600;
  letter-spacing: 0.06rem;
  line-height: 1.2;
  padding: 1.1rem 2.8rem;
  text-decoration: none;
  border-radius: 10rem;
  transition: all 0.2s ease;
  border: none;
  cursor: pointer;
  box-shadow: 0 0.2rem 0.6rem rgba(0, 0, 0, 0.05);
}

.queensmith-button:hover {
  transform: translateY(-0.2rem);
  box-shadow: 0 0.6rem 1.2rem rgba(0, 0, 0, 0.1);
  background: rgb(var(--color-button-hover));
}

/* Reduced motion preference */
@media (prefers-reduced-motion: reduce) {
  .queensmith-auto-carousel__group {
    animation: none;
  }

  .queensmith-auto-carousel {
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .queensmith-card:hover {
    transform: none;
  }
}

/* Mobile adjustments */
@media screen and (max-width: 749px) {
  .queensmith-auto-carousel__group {
    gap: 1rem;
  }

  .queensmith-carousel-container {
    margin-bottom: 2rem;
  }

  .queensmith-card__handle {
    font-size: 1rem;
    padding: 0.6rem 1.2rem;
    bottom: 1rem;
    max-width: 160px;
  }

  .queensmith-card,
  .queensmith-card__image,
  .queensmith-placeholder,
  .queensmith-card-wrapper {
    width: 160px;
    height: 240px;
  }

  @keyframes queensmith-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }
}

/* Tablet adjustments */
@media screen and (min-width: 750px) and (max-width: 989px) {
  .queensmith-card,
  .queensmith-card__image,
  .queensmith-placeholder,
  .queensmith-card-wrapper {
    width: 180px;
    height: 270px;
  }

  .queensmith-card__handle {
    max-width: 160px;
  }
}
{% endstyle %}

<!--
  Section: Say "Yes" with Queensmith
  Version: 1.0.0
  Theme: Dawn compatible
  Description: Auto-scrolling social proof gallery with fixed 200x300 images
-->

<div class="queensmith-gallery-wrapper color-{{ section.settings.color_scheme }} gradient">
  <div class="queensmith-container page-width">
    <!-- Section Header -->
    <div class="queensmith-header text-center">
      <h3 class="queensmith-header__title {{ section.settings.heading_size }}">
        {{ section.settings.title | default: 'Say "Yes" with Queensmith' }}
      </h3>
    </div>

    <!-- Auto-Scrolling Carousel -->
    <div class="queensmith-carousel-container">
      <div class="queensmith-auto-carousel queensmith-auto-carousel--90s">
        <!-- Original Group -->
        <div class="queensmith-auto-carousel__group">
          {% for block in section.blocks %}
            <div class="queensmith-card-wrapper">
              <div class="queensmith-card queensmith-card--rounded">
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 200, height: 300, crop: 'center', format: 'webp' }}"
                    srcset="
                      {{ block.settings.image | image_url: width: 200, height: 300, crop: 'center', format: 'webp' }} 200w,
                      {{ block.settings.image | image_url: width: 400, height: 600, crop: 'center', format: 'webp' }} 400w
                    "
                    alt="{{ block.settings.handle | escape }}"
                    class="queensmith-card__image"
                    width="200"
                    height="300"
                    loading="lazy"
                    decoding="async"
                  >
                {% else %}
                  <div
                    class="queensmith-placeholder"
                    style="width:200px;height:300px;background:#f0f0f0;display:flex;align-items:center;justify-content:center;"
                  >
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" fill="#999"/>
                    </svg>
                  </div>
                {% endif %}
                <div class="queensmith-card__handle">
                  {{ block.settings.handle | default: '@username' }}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Duplicate Group for Seamless Loop -->
        <div class="queensmith-auto-carousel__group" aria-hidden="true">
          {% for block in section.blocks %}
            <div class="queensmith-card-wrapper">
              <div class="queensmith-card queensmith-card--rounded">
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 200, height: 300, crop: 'center', format: 'webp' }}"
                    srcset="
                      {{ block.settings.image | image_url: width: 200, height: 300, crop: 'center', format: 'webp' }} 200w,
                      {{ block.settings.image | image_url: width: 400, height: 600, crop: 'center', format: 'webp' }} 400w
                    "
                    alt="{{ block.settings.handle | escape }}"
                    class="queensmith-card__image"
                    width="200"
                    height="300"
                    loading="lazy"
                    decoding="async"
                  >
                {% else %}
                  <div
                    class="queensmith-placeholder"
                    style="width:200px;height:300px;background:#f0f0f0;display:flex;align-items:center;justify-content:center;"
                  >
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" fill="#999"/>
                    </svg>
                  </div>
                {% endif %}
                <div class="queensmith-card__handle">
                  {{ block.settings.handle | default: '@username' }}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Social Proof Tag -->
    <div class="queensmith-social-tag">
      <div class="queensmith-social-tag__wrapper">
        <div class="queensmith-avatar-stack">
          {% for block in section.blocks limit: 4 %}
            <div class="queensmith-avatar {% if forloop.index > 1 %}queensmith-avatar--overlap{% endif %}">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 60, height: 60, crop: 'center' }}"
                  alt=""
                  width="60"
                  height="60"
                  loading="lazy"
                  decoding="async"
                >
              {% else %}
                <div class="queensmith-avatar__placeholder"></div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
        <span class="queensmith-social-tag__text">
          {{ section.settings.tag_text | default: 'Join 25,000+ Queensmith Couples' }}
        </span>
      </div>
    </div>

    <!-- Button -->
    {% if section.settings.button_label != blank %}
      <div class="queensmith-button-wrapper">
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="queensmith-button queensmith-button--primary"
        >
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Queensmith Gallery",
  "tag": "section",
  "class": "queensmith-gallery-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Say \"Yes\" with Queensmith"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Social proof text",
      "default": "Join 25,000+ Queensmith Couples"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book Appointment"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    }
  ],
  "blocks": [
    {
      "type": "customer",
      "name": "Customer",
      "limit": 20,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer image",
          "info": "Recommended size: 200x300 pixels (portrait orientation)"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Instagram handle",
          "default": "@username"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Queensmith Gallery",
      "blocks": [
        {
          "type": "customer"
        },
        {
          "type": "customer"
        },
        {
          "type": "customer"
        },
        {
          "type": "customer"
        }
      ]
    }
  ]
}
{% endschema %}

