            "custom_liquid": "<div class=\"ha-accordion\">\n\n  <!-- Product Details -->\n  <div class=\"ha-item active\">\n    <button class=\"ha-header\" type=\"button\">\n      <span class=\"ha-title\">Product Details</span>\n      <span class=\"ha-icon\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\"/></svg>\n      </span>\n    </button>\n    <div class=\"ha-content\">\n      <div class=\"ha-inner rte\">\n        {{ product.description }}\n      </div>\n    </div>\n  </div>\n\n  <!-- Manufacturer -->\n  <div class=\"ha-item\">\n    <button class=\"ha-header\" type=\"button\">\n      <span class=\"ha-title\">Manufacturer &amp; Origin</span>\n      <span class=\"ha-icon\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\"/></svg>\n      </span>\n    </button>\n    <div class=\"ha-content\">\n      <div class=\"ha-inner\">\n        <p><strong>Manufacturer:</strong> HB Prestige</p>\n        <p><strong>Address:</strong> Your Company Address</p>\n        <p><strong>Country of Origin:</strong> India</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- Shipping -->\n  <div class=\"ha-item\">\n    <button class=\"ha-header\" type=\"button\">\n      <span class=\"ha-title\">Shipping &amp; Returns</span>\n      <span class=\"ha-icon\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\"/></svg>\n      </span>\n    </button>\n    <div class=\"ha-content\">\n      <div class=\"ha-inner\">\n        <ul>\n          <li>Free Shipping above ₹2999.</li>\n          <li>Dispatch within 1–2 business days.</li>\n          <li>Easy Returns within 7 Days.</li>\n        </ul>\n      </div>\n    </div>\n  </div>\n\n  <!-- Wash Care -->\n  <div class=\"ha-item\">\n    <button class=\"ha-header\" type=\"button\">\n      <span class=\"ha-title\">Wash Care</span>\n      <span class=\"ha-icon\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\"/></svg>\n      </span>\n    </button>\n    <div class=\"ha-content\">\n      <div class=\"ha-inner\">\n        <ul>\n          <li>Dry Clean Recommended.</li>\n          <li>Do Not Bleach.</li>\n          <li>Iron on Low Heat.</li>\n          <li>Store in a Cool &amp; Dry Place.</li>\n        </ul>\n      </div>\n    </div>\n  </div>\n\n  <!-- Customer Support -->\n  <div class=\"ha-item\">\n    <button class=\"ha-header\" type=\"button\">\n      <span class=\"ha-title\">Customer Support</span>\n      <span class=\"ha-icon\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\"/></svg>\n      </span>\n    </button>\n    <div class=\"ha-content\">\n      <div class=\"ha-inner\">\n        <p>Email : hbprestigejewels@gmail.com</p>\n        <p>Phone : +91 9723328111</p>\n        <p>Mon - Sat : 10:00 AM - 7:00 PM</p>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<style>\n.ha-accordion{\n  --accent: #c9a15a;\n  --text-dark: #1c1c1c;\n  --border: #ebe7e0;\n  width: 100%;\n  max-width: 100%;\n  border-radius: 20px;\n  overflow: hidden;\n  background: #fff;\n  margin: 32px 0;\n  box-shadow: 0 2px 14px rgba(0,0,0,0.05);\n  border: 1px solid black;\n  font-family: inherit;\n}\n\n.ha-item{\n  border-bottom: 1px solid var(--border);\n  position: relative;\n}\n.ha-item:last-child{ border-bottom: none; }\n\n.ha-header{\n  width: 100%;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 16px;\n  padding: 10px 22px;\n  background: transparent;\n  border: none;\n  cursor: pointer;\n  text-align: left;\n  transition: background .25s ease;\n}\n\n.ha-header:hover{ background: #faf8f4; }\n\n.ha-title{\n  font-size: 16px;\n  font-weight: 600;\n  color: var(--text-dark);\n  letter-spacing: .2px;\n  position: relative;\n  transition: color .25s ease;\n}\n\n.ha-item.active .ha-title{ color: var(--accent); }\n\n.ha-icon{\n  flex-shrink: 0;\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  border: 1.5px solid var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all .3s ease;\n}\n\n.ha-icon svg{\n  width: 14px;\n  height: 14px;\n  transition: transform .35s cubic-bezier(.4,0,.2,1);\n}\n.ha-icon svg path{\n  stroke: var(--text-dark);\n  stroke-width: 2;\n  stroke-linecap: round;\n  fill: none;\n}\n\n.ha-item.active .ha-icon{\n  background: var(--accent);\n  border-color: var(--accent);\n}\n.ha-item.active .ha-icon svg path{ stroke: #fff; }\n.ha-item.active .ha-icon svg{ transform: rotate(135deg); }\n\n.ha-content{\n  max-height: 0;\n  overflow: hidden;\n  transition: max-height .4s cubic-bezier(.4,0,.2,1);\n}\n\n.ha-inner{\n  padding: 0 22px;\n}\n\n.ha-item.active .ha-inner{\n  padding: 0 22px 22px;\n}\n\n.ha-inner p{ margin: 0 0 12px; line-height: 1.75; color: #444; }\n.ha-inner ul{ margin: 0; padding-left: 18px; }\n.ha-inner li{ margin-bottom: 8px; line-height: 1.6; color: #444; }\n.ha-inner img{ max-width: 100%; height: auto; border-radius: 6px; }\n.ha-inner iframe, .ha-inner video{ max-width: 100%; border-radius: 6px; }\n\n/* subtle left accent bar on active item */\n.ha-item.active::before{\n  content: \"\";\n  position: absolute;\n  left: 0; top: 0; bottom: 0;\n  width: 3px;\n  background: var(--accent);\n}\n\n@media (max-width: 768px){\n  .ha-accordion{ margin: 22px 0; border-radius: 10px; }\n  .ha-header{ padding: 16px 16px; }\n  .ha-title{ font-size: 14.5px; }\n  .ha-icon{ width: 26px; height: 26px; }\n  .ha-icon svg{ width: 12px; height: 12px; }\n  .ha-item.active .ha-inner{ padding: 0 16px 18px; }\n  .ha-inner{ padding: 0 16px; }\n}\n\n/* ===== TABLE (no scroll, content wraps) ===== */\n.ha-inner table{\n  display: table;\n  width: 100%;\n  table-layout: fixed;\n  border-collapse: separate;\n  border-spacing: 0;\n  border-radius: 20px;\n  overflow: hidden;\n}\n\n.ha-inner table th,\n.ha-inner table td{\n  padding: 6px;\n  text-align: left;\n  border-bottom: 1px solid var(--border);\n  border-right: 1px solid var(--border);\n  font-size: 13px;\n  line-height: 1.5;\n  vertical-align: middle;\n  white-space: normal;\n  word-break: break-word;\n  overflow-wrap: break-word;\n}\n\n/* remove double border on last column/row */\n.ha-inner table th:last-child,\n.ha-inner table td:last-child{\n  border-right: none;\n}\n.ha-inner table tr:last-child td{\n  border-bottom: none;\n}\n\n.ha-inner table th{\n  background: #faf8f4;\n  font-weight: 600;\n  color: var(--text-dark);\n}\n\n.ha-inner table tr:nth-child(even) td{\n  background: #fcfcfb;\n}\n\n@media (max-width: 768px){\n  .ha-inner table{ border-radius: 14px; }\n  .ha-inner table th,\n  .ha-inner table td{\n    padding: 6px;\n    font-size: 12.5px;\n  }\n}\n</style>\n\n<script>\n(function () {\n  function initAccordion(root) {\n    const accordion = (root || document).querySelector(\".ha-accordion\");\n    if (!accordion || accordion.dataset.haInit === \"true\") return;\n    accordion.dataset.haInit = \"true\";\n\n    const items = accordion.querySelectorAll(\".ha-item\");\n\n    function setHeight(item, open) {\n      const content = item.querySelector(\".ha-content\");\n      const inner = item.querySelector(\".ha-inner\");\n      if (open) {\n        content.style.maxHeight = inner.scrollHeight + \"px\";\n      } else {\n        content.style.maxHeight = \"0px\";\n      }\n    }\n\n    items.forEach(function (item) {\n      const header = item.querySelector(\".ha-header\");\n\n      // initial state for the item that's active by default\n      if (item.classList.contains(\"active\")) {\n        requestAnimationFrame(function () { setHeight(item, true); });\n      }\n\n      header.addEventListener(\"click\", function () {\n        const isActive = item.classList.contains(\"active\");\n\n        items.forEach(function (i) {\n          i.classList.remove(\"active\");\n          setHeight(i, false);\n        });\n\n        if (!isActive) {\n          item.classList.add(\"active\");\n          setHeight(item, true);\n        }\n      });\n    });\n\n    // Recalculate open item's height on resize (content reflow, e.g. font load, image load)\n    window.addEventListener(\"resize\", function () {\n      accordion.querySelectorAll(\".ha-item.active\").forEach(function (item) {\n        setHeight(item, true);\n      });\n    });\n  }\n\n  document.addEventListener(\"DOMContentLoaded\", () => initAccordion(document));\n  document.addEventListener(\"shopify:section:load\", (e) => initAccordion(e.target));\n})();\n</script>"
          }
        },
        "custom_liquid_PPLLjy": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"why-shop-box\">\n\n  <div class=\"why-header\">\n    <h2 class=\"why-title\">Why Shop With Us</h2>\n    <span class=\"why-underline\"></span>\n  </div>\n\n  <div class=\"why-scroll\">\n    <div class=\"why-grid\">\n\n      <!-- BIS -->\n      <div class=\"why-item\">\n        <div class=\"why-icon\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0743/0825/5844/files/images.png?v=1773853311\" alt=\"BIS Hallmark\" loading=\"lazy\">\n        </div>\n        <p>BIS<br>Hallmark</p>\n      </div>\n\n      <!-- Exchange -->\n      <div class=\"why-item\">\n        <div class=\"why-icon\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0743/0825/5844/files/exchange.png?v=1773853176\" alt=\"Exchange\" loading=\"lazy\">\n        </div>\n        <p>Exchange &amp;<br>Buyback</p>\n      </div>\n\n      <!-- Returns -->\n      <div class=\"why-item\">\n        <div class=\"why-icon\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0743/0825/5844/files/past.png?v=1773853175\" alt=\"Returns\" loading=\"lazy\">\n        </div>\n        <p>Free 15-Day<br>Returns</p>\n      </div>\n\n      <!-- Certificate -->\n      <div class=\"why-item\">\n        <div class=\"why-icon\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0743/0825/5844/files/good-idea.png?v=1773853177\" alt=\"Certified\" loading=\"lazy\">\n        </div>\n        <p>Hbprestige<br>Certified</p>\n      </div>\n\n      <!-- Rating -->\n      <div class=\"why-item\">\n        <div class=\"why-icon\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0743/0825/5844/files/rate.png?v=1773853177\" alt=\"Rating\" loading=\"lazy\">\n        </div>\n        <p>Rated<br>4.7/5</p>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<style>\n.why-shop-box{\n  --accent: #c9a15a;\n  --accent-light: #f4e7d0;\n  --text-dark: #1c1c1c;\n  box-sizing: border-box;\n  border: 1px solid #000;\n  border-radius: 16px;\n  padding: 24px 20px;\n  background: linear-gradient(180deg, #ffffff 0%, #fdfbf7 100%);\n  font-family: \"Poppins\", Arial, sans-serif;\n  overflow: hidden;\n  box-shadow: 0 2px 16px rgba(0,0,0,0.05);\n}\n\n.why-shop-box *{\n  box-sizing: border-box;\n}\n\n/* HEADER */\n.why-header{\n  margin-bottom: 20px;\n}\n.why-title{\n  font-size: 16px;\n  color: var(--text-dark);\n  font-weight: 600;\n  letter-spacing: .3px;\n  margin: 0 0 8px;\n}\n.why-underline{\n  display: block;\n  width: 40px;\n  height: 3px;\n  border-radius: 3px;\n  background: linear-gradient(90deg, var(--accent), #e6c988);\n}\n\n/* SCROLL WRAPPER */\n.why-scroll{\n  overflow-x: auto;\n  overflow-y: visible;\n  -webkit-overflow-scrolling: touch;\n  padding: 4px 2px 6px;\n  margin: -4px -2px -6px;\n}\n.why-scroll::-webkit-scrollbar{ display: none; }\n.why-scroll{\n  scrollbar-width: none;\n  -ms-overflow-style: none;\n}\n\n/* GRID */\n.why-grid{\n  display: flex;\n  gap: 20px;\n  width: max-content;\n  min-width: 100%;\nflex-wrap:wrap;\n}\n\n/* ITEM */\n.why-item{\n  text-align: center;\n  flex: 0 0 auto;\n  width: 92px;\n  cursor: default;\n}\n\n/* ICON */\n.why-icon{\n  width: 64px;\n  height: 64px;\n  margin: 0 auto 12px;\n  background: linear-gradient(145deg, var(--accent-light), #ffffff);\n  border: 1px solid #f0e2c4;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 3px 10px rgba(201,161,90,0.18);\n  transition: transform .3s ease, box-shadow .3s ease;\n}\n\n.why-item:hover .why-icon{\n  transform: translateY(-4px);\n  box-shadow: 0 8px 18px rgba(201,161,90,0.3);\n}\n\n.why-icon img{\n  width: 30px;\n  height: 30px;\n  object-fit: contain;\n  display: block;\n}\n\n/* TEXT */\n.why-item p{\n  font-size: 11.5px;\n  color: #444;\n  font-weight: 500;\n  line-height: 1.45;\n  margin: 0;\n  white-space: normal;\n  word-break: normal;\n  overflow-wrap: break-word;\n  transition: color .3s ease;\n}\n\n.why-item:hover p{\n  color: var(--accent);\n}\n\n/* DESKTOP */\n@media (min-width: 768px){\n  .why-scroll{ overflow: visible; padding: 0; margin: 0; }\n  .why-grid{\n    width: 100%;\n    min-width: 0;\n    justify-content: space-between;\n    gap: 8px;\n  }\n  .why-item{ flex: 1 1 0; width: auto; min-width: 0; }\n  .why-icon{ width: 70px; height: 70px; }\n  .why-icon img{ width: 34px; height: 34px; }\n  .why-item p{ font-size: 12.5px; }\n}\n\n/* MOBILE FINE-TUNE */\n@media (max-width: 767px){\n  .why-shop-box{ padding: 20px 16px; border-radius: 14px; }\n  .why-title{ font-size: 14.5px; }\n}\n</style>"
          }
        }
