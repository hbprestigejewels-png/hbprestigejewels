stener('click', () => {\n    const item = header.parentElement;\n\n    // close others\n    document.querySelectorAll('.accordion-item').forEach(i => {\n      if (i !== item) i.classList.remove('active');\n    });\n\n    item.classList.toggle('active');\n  });\n});\n</script>"
