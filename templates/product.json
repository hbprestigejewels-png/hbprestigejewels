rdion-item\">\n    <button class=\"accordion-header\" type=\"button\">\n      <span>Customer Support</span>\n      <span class=\"icon\">+</span>\n    </button>\n\n    <div class=\"accordion-content\">\n      <div class=\"accordion-inner\">\n        <p>Email : support@example.com</p>\n        <p>Phone : +91 97171 00683</p>\n        <p>Mon - Sat : 10:00 AM - 7:00 PM</p>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<style>\n.custom-accordion{\n    width:100%;\n    border:1px solid #e5e5e5;\n    border-radius:8px;\n    overflow:hidden;\n    background:#fff;\n    margin:30px 0;\n}\n\n.accordion-item+.accordion-item{\n    border-top:1px solid #ececec;\n}\n\n.accordion-header{\n    width:100%;\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n    padding:18px 22px;\n    background:#fafafa;\n    border:none;\n    cursor:pointer;\n    font-size:16px;\n    font-weight:600;\n    color:#222;\n    transition:.3s;\n}\n\n.accordion-header:hover{\n    background:#f4f4f4;\n}\n\n.icon{\n    font-size:24px;\n    transition:.3s;\n    line-height:1;\n}\n\n.accordion-content{\n    max-height:0;\n    overflow:hidden;\n    transition:max-height .35s ease;\n}\n\n.accordion-inner{\n    padding:0 22px;\n}\n\n.accordion-item.active .accordion-content{\n    max-height:3000px;\n}\n\n.accordion-item.active .accordion-inner{\n    padding:20px 22px;\n}\n\n.accordion-item.active .icon{\n    transform:rotate(45deg);\n}\n\n.accordion-inner p{\n    margin:0 0 12px;\n    line-height:1.8;\n}\n\n.accordion-inner ul{\n    margin:0;\n    padding-left:18px;\n}\n\n.accordion-inner li{\n    margin-bottom:8px;\n}\n\n.accordion-inner img{\n    max-width:100%;\n    height:auto;\n}\n\n.accordion-inner table{\n    display:block;\n    overflow:auto;\n    width:100%;\n}\n\n.accordion-inner iframe,\n.accordion-inner video{\n    max-width:100%;\n}\n\n@media(max-width:768px){\n\n.accordion-header{\n    padding:15px;\n    font-size:15px;\n}\n\n.accordion-item.active .accordion-inner{\n    padding:15px;\n}\n\n}\n</style>\n\n<script>\ndocument.querySelectorAll(\".accordion-header\").forEach(function(header){\n\nheader.addEventListener(\"click\",function(){\n\nconst item=this.parentElement;\n\ndocument.querySelectorAll(\".accordion-item\").forEach(function(acc){\n\nif(acc!==item){\nacc.classList.remove(\"active\");\n}\n\n});\n\nitem.classList.toggle(\"active\");\n\n});\n\n});\n</script>"
