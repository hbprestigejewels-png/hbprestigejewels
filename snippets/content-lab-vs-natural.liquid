<style>
  .education-page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
    font-family: var(--font-body-family);
    color: #1f2937;
  }

  .edu-hero {
    text-align: center;
    padding: 3.5rem 1.5rem 3rem;
    background: linear-gradient(180deg, #fbfbfb 0%, #f4f5f7 100%);
    border-radius: 16px;
    margin-bottom: 3.5rem;
    border: 1px solid #ebecee;
  }

  .edu-badge {
    display: inline-block;
    background: #111111;
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.4rem 1.4rem;
    border-radius: 20px;
    margin-bottom: 1.2rem;
  }

  .edu-hero__title {
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 4.2vw, 4.2rem);
    font-weight: 600;
    color: #111111;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .edu-hero__subtitle {
    font-size: 1.5rem;
    color: #4b5563;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.65;
  }

  .edu-grid-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 4rem;
  }

  .edu-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .edu-card__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .edu-card__icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #f3f4f6;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
  }

  .edu-card__title {
    font-size: 2rem;
    font-weight: 600;
    color: #111111;
    margin: 0;
  }

  .edu-card__text {
    font-size: 1.4rem;
    color: #4b5563;
    line-height: 1.7;
    margin: 0 0 1.5rem;
  }

  .edu-card__list {
    padding-left: 1.5rem;
    margin: 0;
    color: #374151;
    font-size: 1.35rem;
    line-height: 1.8;
  }

  .edu-table-section {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 2.5rem 2rem;
    margin-bottom: 4rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .edu-table-section__title {
    font-size: 2.2rem;
    font-weight: 600;
    color: #111111;
    margin: 0 0 1.8rem;
    text-align: center;
  }

  .edu-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.35rem;
  }

  .edu-table th {
    background: #f9fafb;
    padding: 1.2rem 1.4rem;
    font-weight: 600;
    color: #111111;
    border-bottom: 2px solid #e5e7eb;
    text-align: left;
  }

  .edu-table td {
    padding: 1.2rem 1.4rem;
    border-bottom: 1px solid #f3f4f6;
    color: #4b5563;
    line-height: 1.6;
  }

  .edu-table tr:nth-child(even) td {
    background-color: #fafbfc;
  }

  .edu-info-box {
    background: #111111;
    color: #ffffff;
    border-radius: 16px;
    padding: 3rem 2.5rem;
    text-align: center;
  }

  .edu-info-box h3 {
    color: #ffffff;
    font-size: 2.2rem;
    margin: 0 0 1rem;
  }

  .edu-info-box p {
    color: #9ca3af;
    font-size: 1.45rem;
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .edu-btn {
    display: inline-block;
    background: #ffffff;
    color: #111111;
    font-weight: 600;
    padding: 0.9rem 2.2rem;
    border-radius: 8px;
    text-decoration: none;
    font-size: 1.35rem;
    transition: background 0.2s ease;
  }

  .edu-btn:hover {
    background: #e5e7eb;
  }

  @media screen and (max-width: 768px) {
    .edu-grid-2col {
      grid-template-columns: 1fr;
    }
    .education-page-container {
      padding: 2rem 1.5rem 4rem;
    }
  }
</style>

<div class="education-page-container">
  <div class="edu-hero">
    <span class="edu-badge">{{ section.settings.badge | default: 'Diamond Education' }}</span>
    <h1 class="edu-hero__title">{{ section.settings.title | default: 'Natural vs. Lab-Grown Diamonds' }}</h1>
    <p class="edu-hero__subtitle">
      {{ section.settings.subtitle | default: 'Everything you need to know about the science, beauty, value, and authenticity of natural and lab-created diamonds.' }}
    </p>
  </div>

  <div class="edu-grid-2col">
    <div class="edu-card">
      <div>
        <div class="edu-card__header">
          <div class="edu-card__icon">🧪</div>
          <h3 class="edu-card__title">{{ section.settings.lab_title | default: 'Lab-Grown Diamonds' }}</h3>
        </div>
        <p class="edu-card__text">
          {{ section.settings.lab_desc | default: 'Lab-grown diamonds are 100% real diamonds created in highly controlled laboratory environments replicating the exact natural formation processes.' }}
        </p>
        <ul class="edu-card__list">
          <li><strong>Identical Composition:</strong> Pure carbon crystal lattice structure.</li>
          <li><strong>Same Brilliance & Fire:</strong> 10/10 Mohs hardness scale.</li>
          <li><strong>Exceptional Value:</strong> 50% to 70% more affordable for equivalent carat weight.</li>
          <li><strong>Full Certification:</strong> Certified by leading institutes like IGI and GIA.</li>
        </ul>
      </div>
    </div>

    <div class="edu-card">
      <div>
        <div class="edu-card__header">
          <div class="edu-card__icon">🌍</div>
          <h3 class="edu-card__title">{{ section.settings.natural_title | default: 'Natural Diamonds' }}</h3>
        </div>
        <p class="edu-card__text">
          {{ section.settings.natural_desc | default: 'Natural diamonds formed deep inside the Earth billions of years ago under extreme heat and pressure, celebrated for their geological rarity and timeless legacy.' }}
        </p>
        <ul class="edu-card__list">
          <li><strong>Geological Miracle:</strong> Formed 1 to 3 billion years ago deep in Earth’s mantle.</li>
          <li><strong>Rarity & Heritage:</strong> Limited finite natural supply mined globally.</li>
          <li><strong>Traditional Prestige:</strong> Cherished heritage value passed across generations.</li>
          <li><strong>Global Grading:</strong> Evaluated by the 4Cs (Cut, Color, Clarity, Carat).</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="edu-table-section">
    <h2 class="edu-table-section__title">Side-by-Side Comparison</h2>
    <div style="overflow-x: auto;">
      <table class="edu-table">
        <thead>
          <tr>
            <th>Feature</th>
            <th>Lab-Grown Diamonds</th>
            <th>Natural Mined Diamonds</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Chemical Composition</strong></td>
            <td>100% Crystallized Carbon (C)</td>
            <td>100% Crystallized Carbon (C)</td>
          </tr>
          <tr>
            <td><strong>Hardness & Durability</strong></td>
            <td>10 on Mohs Scale (Extremely durable)</td>
            <td>10 on Mohs Scale (Extremely durable)</td>
          </tr>
          <tr>
            <td><strong>Refractive Index & Sparkle</strong></td>
            <td>2.42 (Identical optical brilliance & fire)</td>
            <td>2.42 (Identical optical brilliance & fire)</td>
          </tr>
          <tr>
            <td><strong>Grading Standards</strong></td>
            <td>Certified with 4Cs by IGI, GIA, HRD</td>
            <td>Certified with 4Cs by GIA, IGI, HRD</td>
          </tr>
          <tr>
            <td><strong>Creation Origin</strong></td>
            <td>Advanced CVD / HPHT technology</td>
            <td>Earth’s mantle over billions of years</td>
          </tr>
          <tr>
            <td><strong>Price & Carat Value</strong></td>
            <td>High affordability — larger stones for budget</td>
            <td>Premium price driven by rarity & mining</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="edu-info-box">
    <h3>{{ section.settings.cta_title | default: 'Still Choosing the Right Diamond?' }}</h3>
    <p>{{ section.settings.cta_desc | default: 'Our dedicated jewellery specialists are available to guide you through cut, carat, and certification with total transparency.' }}</p>
    <a href="{{ section.settings.cta_link | default: '/pages/contact' }}" class="edu-btn">
      {{ section.settings.cta_text | default: 'Book a Consultation' }}
    </a>
  </div>
</div>
