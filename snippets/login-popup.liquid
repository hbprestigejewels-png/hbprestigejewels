{% comment %}
  HB Prestige Jewels — Contact / Help Popup & Modal Bridge
  (Login popup functionality merged into newsletter-popup.liquid to prevent duplicate modals)
{% endcomment %}

<!-- ═══════════════════════════════════════════════════
     CONTACT / HELP POPUP (Trigger from header/support)
═══════════════════════════════════════════════════ -->
<div
  id="hbp-help-popup-overlay"
  role="dialog"
  aria-modal="true"
  style="
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999999;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(6px);
    align-items: center;
    justify-content: center;
    padding: 1.6rem;
  "
>
  <div style="
    background: #ffffff;
    border-radius: 20px;
    width: 100%;
    max-width: 420px;
    box-shadow: 0 32px 80px rgba(0,0,0,0.22);
    position: relative;
    overflow: hidden;
    animation: hbpSlideUp 0.38s cubic-bezier(0.22,0.97,0.36,1);
  ">
    <!-- Close -->
    <button
      onclick="document.getElementById('hbp-help-popup-overlay').style.display='none'"
      aria-label="Close"
      type="button"
      style="
        position:absolute; top:1.2rem; right:1.2rem;
        width:34px; height:34px; border-radius:50%;
        background:#f3f4f6; border:none; cursor:pointer;
        font-size:1.8rem; display:flex; align-items:center; justify-content:center;
        color:#333; z-index:2;
      "
    >&times;</button>

    <!-- Header -->
    <div style="padding:3rem 2.4rem 2rem; text-align:center;">
      <h2 style="font-size:2.2rem; font-weight:700; color:#111; margin:0 0 0.5rem; line-height:1.3;">
        Need Help Choosing The Right Diamond Or Jewellery?
      </h2>
      <p style="font-size:1.3rem; color:#666; margin:0;">Our experts are here to guide you.</p>
    </div>

    <!-- Options -->
    <div style="padding:0 2rem 2.5rem; display:flex; flex-direction:column; gap:1rem;">
      <!-- Email -->
      <a
        href="mailto:info@hbprestigejewels.com"
        style="
          display:flex; align-items:center; gap:1.4rem;
          padding:1.4rem 1.6rem;
          border:1px solid #e5e7eb; border-radius:14px;
          text-decoration:none; color:#111;
          background:#fff;
        "
      >
        <div style="width:46px; height:46px; border-radius:50%; background:#1a1a2e; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#c6a43b" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 7 10-7"/></svg>
        </div>
        <div style="flex:1;">
          <p style="margin:0; font-size:1.35rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em;">Email Now</p>
          <p style="margin:0.2rem 0 0; font-size:1.2rem; color:#666;">Send us a message</p>
        </div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </a>

      <!-- WhatsApp -->
      <a
        href="https://wa.me/919876543210"
        target="_blank"
        rel="noopener"
        style="
          display:flex; align-items:center; gap:1.4rem;
          padding:1.4rem 1.6rem;
          border:1px solid #dcfce7; border-radius:14px;
          text-decoration:none; color:#111;
          background:#f0fdf4;
        "
      >
        <div style="width:46px; height:46px; border-radius:50%; background:#25d366; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="#fff"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        </div>
        <div style="flex:1;">
          <p style="margin:0; font-size:1.35rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em;">WhatsApp</p>
          <p style="margin:0.2rem 0 0; font-size:1.2rem; color:#166534;">Chat with us instantly</p>
        </div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';
  // Point any header login button to the unified Sign-in modal
  window.hbpOpenLoginPopup = function() {
    if (typeof window.hbpOpenSignInModal === 'function') {
      window.hbpOpenSignInModal();
    }
  };
  window.hbpCloseLoginPopup = function() {
    if (typeof window.hbpCloseSignInModal === 'function') {
      window.hbpCloseSignInModal();
    }
  };

  // Help popup trigger
  window.hbpOpenHelpPopup = function () {
    const hp = document.getElementById('hbp-help-popup-overlay');
    if (!hp) return;
    hp.style.display = 'flex';
  };
})();
</script>
