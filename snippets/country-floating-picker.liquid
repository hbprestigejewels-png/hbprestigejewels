<style>
  .floating-country-picker-wrapper {
    position: fixed;
    bottom: 22px;
    left: 22px;
    z-index: 99998;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  .floating-country-disclosure {
    position: relative;
    display: inline-block;
  }

  /* MATCHING SCREENSHOT PILL (BORDER, ROUNDED, PADDING, SHADOW) */
  .floating-country-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #ffffff;
    color: #111111;
    border: 1px solid rgba(0, 0, 0, 0.16);
    border-radius: 8px;
    padding: 6px 11px;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1), 0 1px 3px rgba(0, 0, 0, 0.05);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    outline: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .floating-country-btn:hover {
    border-color: #111111;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    transform: translateY(-2px);
  }

  .floating-country-flag-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 0 1px rgba(0,0,0,0.3);
  }

  .floating-country-flag-icon img {
    display: block;
    object-fit: cover;
    width: 18px;
    height: 13px;
  }

  .floating-country-code {
    font-size: 13px;
    font-weight: 600;
    color: #1a1a1a;
    letter-spacing: 0.02em;
  }

  .floating-country-caret {
    width: 8px;
    height: 5px;
    color: #555555;
    transition: transform 0.25s ease;
    margin-left: 2px;
  }

  .floating-country-btn.is-active .floating-country-caret {
    transform: rotate(180deg);
  }

  /* DROPDOWN POPUP (OPENS UPWARDS) */
  .floating-country-dropdown {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 0;
    width: 310px;
    max-width: 90vw;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2), 0 2px 8px rgba(0, 0, 0, 0.08);
    border: 1px solid #e5e7eb;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: floatCountryFadeUp 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 999999;
  }

  @keyframes floatCountryFadeUp {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .floating-country-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-bottom: 1px solid #f3f4f6;
    background: #fafafa;
  }

  .floating-country-title {
    font-size: 13.5px;
    font-weight: 600;
    color: #111111;
  }

  .floating-country-close {
    background: #f3f4f6;
    border: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    color: #555;
    padding: 0;
    transition: all 0.2s ease;
  }

  .floating-country-close:hover {
    background: #e5e7eb;
    color: #000;
    transform: scale(1.08);
  }

  /* SEARCH INPUT */
  .floating-country-search-box {
    position: relative;
    padding: 10px 12px;
    border-bottom: 1px solid #f0f0f0;
    display: flex;
    align-items: center;
  }

  .floating-country-search-icon {
    position: absolute;
    left: 22px;
    width: 14px;
    height: 14px;
    color: #888888;
    pointer-events: none;
  }

  .floating-country-search-input {
    width: 100%;
    padding: 8px 10px 8px 30px;
    font-size: 13px;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    outline: none;
    box-sizing: border-box;
    font-family: inherit;
    background: #fdfdfd;
  }

  .floating-country-search-input:focus {
    border-color: #111111;
    background: #ffffff;
  }

  .floating-country-section-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #888888;
    padding: 8px 14px 4px;
    background: #ffffff;
  }

  /* COUNTRY ITEMS LIST */
  .floating-country-items {
    list-style: none;
    margin: 0;
    padding: 4px 0;
    max-height: 160px;
    overflow-y: auto;
  }

  .floating-country-items--all {
    max-height: 180px;
    border-top: 1px solid #f5f5f5;
  }

  .floating-country-item {
    margin: 0;
    padding: 0;
  }

  .floating-country-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    text-decoration: none;
    color: #333333;
    font-size: 13px;
    transition: background 0.15s ease;
  }

  .floating-country-link:hover,
  .floating-country-link.is-active {
    background: #f4f6f8;
    color: #000000;
  }

  .floating-country-item-flag {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .floating-country-item-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 500;
  }

  .floating-country-item-currency {
    color: #777777;
    font-size: 12px;
    flex-shrink: 0;
  }

  .floating-country-checkmark {
    color: #111111;
    font-weight: bold;
    margin-left: 4px;
  }

  .floating-country-native-form {
    display: none;
  }

  @media (max-width: 768px) {
    .floating-country-picker-wrapper {
      bottom: 16px;
      left: 16px;
    }
    .floating-country-btn {
      padding: 5px 9px;
      font-size: 12.5px;
    }
    .floating-country-dropdown {
      width: 280px;
    }
  }
</style>

<script>
  (function () {
    const btn = document.getElementById('FloatingCountryButton');
    const dropdown = document.getElementById('FloatingCountryList');
    const closeBtn = document.getElementById('FloatingCountryCloseBtn');
    const searchInput = document.getElementById('FloatingCountrySearchInput');
    const form = document.getElementById('FloatingCountryForm');
    const hiddenInput = document.getElementById('FloatingCountryHiddenInput');
    const wrapper = document.getElementById('FloatingCountryPickerWrapper');
    const currentFlag = document.getElementById('FloatingCountryCurrentFlag');
    const currentCode = document.getElementById('FloatingCountryCurrentCode');

    if (!btn || !dropdown) return;

    // Load saved user selection if any
    const savedCountry = localStorage.getItem('hb_user_selected_country');
    const savedCurrency = localStorage.getItem('hb_user_selected_currency');
    if (savedCountry && savedCurrency && currentFlag && currentCode) {
      currentFlag.src = `https://flagcdn.com/w40/${savedCountry.toLowerCase()}.png`;
      currentCode.textContent = savedCurrency;
      
      dropdown.querySelectorAll('.floating-country-link').forEach(link => {
        if (link.getAttribute('data-value') === savedCountry) {
          link.classList.add('is-active');
        } else {
          link.classList.remove('is-active');
        }
      });
    }

    function openMenu() {
      dropdown.style.display = 'flex';
      btn.classList.add('is-active');
      btn.setAttribute('aria-expanded', 'true');
      if (searchInput) {
        setTimeout(() => searchInput.focus(), 60);
      }
    }

    function closeMenu() {
      dropdown.style.display = 'none';
      btn.classList.remove('is-active');
      btn.setAttribute('aria-expanded', 'false');
    }

    function toggleMenu(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      if (dropdown.style.display === 'none' || dropdown.style.display === '') {
        openMenu();
      } else {
        closeMenu();
      }
    }

    btn.addEventListener('click', toggleMenu);

    if (closeBtn) {
      closeBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        closeMenu();
      });
    }

    // Close when clicking anywhere outside
    document.addEventListener('click', function (e) {
      if (wrapper && !wrapper.contains(e.target)) {
        closeMenu();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' || e.key === 'Esc') {
        closeMenu();
      }
    });

    // Filter search
    if (searchInput) {
      searchInput.addEventListener('input', function () {
        const query = this.value.toLowerCase().trim();
        const items = dropdown.querySelectorAll('.floating-country-item');
        items.forEach(item => {
          const name = item.getAttribute('data-country-name') || '';
          const curr = item.getAttribute('data-currency') || '';
          if (name.includes(query) || curr.includes(query)) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    }

    // Submit / select country
    dropdown.querySelectorAll('.floating-country-link').forEach(link => {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        const countryCode = this.getAttribute('data-value');
        const currencyCode = this.getAttribute('data-currency') || countryCode;
        
        if (countryCode) {
          localStorage.setItem('hb_user_selected_country', countryCode);
          localStorage.setItem('hb_user_selected_currency', currencyCode);
          localStorage.setItem('hb_user_explicit_country', 'true');
          
          if (currentFlag) currentFlag.src = `https://flagcdn.com/w40/${countryCode.toLowerCase()}.png`;
          if (currentCode) currentCode.textContent = currencyCode;
          
          dropdown.querySelectorAll('.floating-country-link').forEach(l => l.classList.remove('is-active'));
          this.classList.add('is-active');

          closeMenu();

          {%- if localization.available_countries.size > 1 -%}
            if (hiddenInput && form) {
              hiddenInput.value = countryCode;
              form.submit();
            }
          {%- endif -%}
        }
      });
    });

    // Enhanced IP-Based Auto Detection with multiple fast endpoints
    async function autoDetectCountryByIP() {
      // Check if user manually clicked a country before
      const explicitChoice = localStorage.getItem('hb_user_explicit_country');
      if (explicitChoice) return;

      let detectedCountry = '';

      // Try Endpoint 1: api.country.is (ultra fast & lightweight)
      try {
        const res = await fetch('https://api.country.is/', { cache: 'no-store' });
        if (res.ok) {
          const data = await res.json();
          detectedCountry = (data.country || '').toUpperCase();
        }
      } catch (e) {}

      // Try Endpoint 2: ipapi.co fallback
      if (!detectedCountry) {
        try {
          const res = await fetch('https://ipapi.co/json/', { cache: 'no-store' });
          if (res.ok) {
            const data = await res.json();
            detectedCountry = (data.country_code || data.country || '').toUpperCase();
          }
        } catch (e) {}
      }

      // Try Endpoint 3: ipwhois.app fallback
      if (!detectedCountry) {
        try {
          const res = await fetch('https://ipwhois.app/json/', { cache: 'no-store' });
          if (res.ok) {
            const data = await res.json();
            detectedCountry = (data.country_code || '').toUpperCase();
          }
        } catch (e) {}
      }

      if (detectedCountry) {
        console.log(`🌐 GeoIP Detected User Country: ${detectedCountry}`);
        
        const matchingLink = dropdown.querySelector(`.floating-country-link[data-value="${detectedCountry}"]`);
        let curr = detectedCountry;
        
        if (matchingLink) {
          curr = matchingLink.getAttribute('data-currency') || detectedCountry;
          dropdown.querySelectorAll('.floating-country-link').forEach(l => l.classList.remove('is-active'));
          matchingLink.classList.add('is-active');
        } else {
          // Default mapping for common regions
          const mapCurr = {
            'US': 'USD', 'AU': 'AUD', 'GB': 'GBP', 'CA': 'CAD', 'IN': 'INR', 
            'AE': 'AED', 'NZ': 'NZD', 'SG': 'SGD', 'DE': 'EUR', 'FR': 'EUR', 
            'IT': 'EUR', 'ES': 'EUR', 'NL': 'EUR', 'BE': 'EUR', 'IE': 'EUR', 
            'JP': 'JPY', 'HK': 'HKD', 'CH': 'CHF', 'DK': 'DKK', 'NO': 'NOK'
          };
          curr = mapCurr[detectedCountry] || 'AUD';
        }

        localStorage.setItem('hb_user_selected_country', detectedCountry);
        localStorage.setItem('hb_user_selected_currency', curr);

        if (currentFlag) {
          currentFlag.src = `https://flagcdn.com/w40/${detectedCountry.toLowerCase()}.png`;
          currentFlag.style.display = 'block';
        }
        if (currentCode) currentCode.textContent = curr;

        {%- if localization.available_countries.size > 1 -%}
          if (hiddenInput && form && detectedCountry !== '{{ localization.country.iso_code }}') {
            hiddenInput.value = detectedCountry;
            form.submit();
          }
        {%- endif -%}
      }
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      autoDetectCountryByIP();
    } else {
      window.addEventListener('DOMContentLoaded', autoDetectCountryByIP);
    }
  })();
</script>
