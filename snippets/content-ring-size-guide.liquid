            <tr><td><strong>8</strong></td><td>AU P½</td><td>16</td><td>17</td><td>18.14 mm & 57.00 mm</td></tr>
            <tr><td><strong>8.25</strong></td><td>AU Q</td><td>—</td><td>17.5</td><td>18.34 mm & 57.60 mm</td></tr>
