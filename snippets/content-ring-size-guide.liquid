          <tr><td>12</td><td>X</td><td>68</td><td>21.4 mm</td><td>67.2 mm</td></tr>
          <tr><td>12.5</td><td>Y</td><td>69</td><td>21.8 mm</td><td>68.5 mm</td></tr>
          <tr><td>13</td><td>Z</td><td>70</td><td>22.2 mm</td><td>69.7 mm</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="rsg-tips-section">
    <h2 style="font-size: 2rem; font-weight: 600; margin: 0; color: #111111;">Expert Sizing Tips</h2>
    <div class="rsg-tips-grid">
      <div class="rsg-tip-item">
        <h4 class="rsg-tip-item__title">⏰ Time of Day</h4>
        <p class="rsg-tip-item__desc">Fingers naturally expand throughout the day. Measure in the evening when your hands are warm for the most accurate fit.</p>
      </div>
      <div class="rsg-tip-item">
        <h4 class="rsg-tip-item__title">📐 Knuckle Consideration</h4>
        <p class="rsg-tip-item__desc">If your knuckle is noticeably larger than your finger base, measure both and choose a size in between so the ring slides on comfortably.</p>
      </div>
      <div class="rsg-tip-item">
        <h4 class="rsg-tip-item__title">💍 Band Width Impact</h4>
        <p class="rsg-tip-item__desc">Wider bands (5mm or thicker) fit more snugly than delicate bands. We recommend selecting a half-size larger for wider designs.</p>
      </div>
      <div class="rsg-tip-item">
        <h4 class="rsg-tip-item__title">✨ Complimentary Resizing</h4>
        <p class="rsg-tip-item__desc">Unsure of the exact size? Don't worry! HB Prestige Jewels offers complimentary resizing services on all custom rings.</p>
      </div>
    </div>
  </div>

  <div class="rsg-cta-box">
    <h3>{{ section.settings.cta_title | default: 'Need Personalized Sizing Advice?' }}</h3>
    <p>{{ section.settings.cta_desc | default: 'Our experienced gemologists and jewellery specialists are here to guide you to the perfect size.' }}</p>
    <div class="rsg-cta-buttons">
      <a href="https://wa.me/{{ section.settings.whatsapp_number | default: '919723328111' }}" target="_blank" class="rsg-btn rsg-btn--primary">Chat on WhatsApp</a>
      <a href="/pages/contact" class="rsg-btn rsg-btn--secondary">Contact Us</a>
    </div>
  </div>
</div>

<script>
  (function () {
    function initSearch() {
      const searchInput = document.getElementById('rsg-filter-input');
      const table = document.getElementById('rsg-size-table');
      if (!searchInput || !table) return;

      searchInput.addEventListener('input', function () {
        const query = this.value.trim().toLowerCase();
        const rows = table.querySelectorAll('tbody tr');

        rows.forEach((row) => {
          const text = row.textContent.toLowerCase();
          if (!query) {
            row.classList.remove('highlighted');
            row.style.display = '';
          } else if (text.includes(query)) {
            row.classList.add('highlighted');
            row.style.display = '';
          } else {
            row.classList.remove('highlighted');
            row.style.display = 'none';
          }
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSearch);
    } else {
      initSearch();
    }
  })();
</script>
