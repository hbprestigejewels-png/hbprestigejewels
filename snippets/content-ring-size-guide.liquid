    </div>
  </section>

  <!-- =========================================================================
       SECTION 6: OPTION 2 - RING SIZER TAPE (SPLIT WITH IMAGES)
       ========================================================================= -->
  <section class="rsg-split-section rsg-split-section--tape">
    <div class="rsg-container">
      <div class="rsg-split-grid">
        <div class="rsg-split-media" data-aos="fade-right">
          <div class="rsg-dual-img-wrap">
            <div class="rsg-img-frame rsg-img-frame--main">
              <img
                src="https://diamondsforeveryone.com.au/cdn/shop/files/ChatGPT_Image_Apr_3_2026_05_53_39_PM.png?v=1775219160&width=1066"
                alt="Ring Sizer Measuring Belt"
                loading="lazy"
                class="rsg-img"
              >
            </div>
            <div class="rsg-img-frame rsg-img-frame--sub">
              <img
                src="https://diamondsforeveryone.com.au/cdn/shop/files/jewelry_BGAiUpcJ_jpg_2.webp?v=1767088155&width=1066"
                alt="Ring Measuring In Action"
                loading="lazy"
                class="rsg-img"
              >
            </div>
          </div>
        </div>
        <div class="rsg-split-content" data-aos="fade-left">
          <span class="rsg-subtag">RECOMMENDED METHOD</span>
          <h2 class="rsg-section-title">Option 2: Use a Ring Sizer Tape</h2>
          <p class="rsg-desc">
            If you don't have a ring to measure, using a <strong>ring sizer tape</strong> is one of the most accurate ways to determine your ring size at home. It allows you to measure your finger comfortably and ensures a precise fit when ordering engagement rings or custom jewellery.
          </p>
          <h3 class="rsg-subheading">We Can Send You a Professional Ring Sizer</h3>
          <p class="rsg-desc">
            HB Prestige Jewels can provide a professional ring sizer tape so you can measure your finger accurately from the comfort of your home.
          </p>
          <ul class="rsg-bullet-list">
            <li>Measures accurate international ring sizes</li>
            <li>Simple, secure, reusable, and easy to use</li>
            <li>Perfect for engagement rings and custom jewellery orders</li>
          </ul>
          <div class="rsg-btn-wrapper">
            <a href="#request-sizer" class="rsg-btn">REQUEST RING SIZER</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 7 & 8: REQUEST FREE RING SIZER FORM
       ========================================================================= -->
  <section class="rsg-form-section" id="request-sizer">
    <div class="rsg-container">
      <div class="rsg-form-card" data-aos="fade-up">
        <div class="rsg-form-header text-center">
          <span class="rsg-subtag">COMPLIMENTARY TOOL</span>
          <h2 class="rsg-form-title">Request Your FREE DIY Ring Sizer</h2>
          <p class="rsg-form-desc">
            Fill out the form below with your name and delivery address, and we’ll send a complimentary precision ring sizer right to your doorstep.
          </p>
        </div>

        {%- form 'contact', id: 'RingSizerRequestForm', class: 'rsg-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="rsg-form-success" tabindex="-1" autofocus>
              ✓ Thank you! Your request for a free ring sizer has been received. Our team will arrange delivery promptly.
            </div>
          {%- elsif form.errors -%}
            <div class="rsg-form-error">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <input type="hidden" name="contact[Subject]" value="Free Ring Sizer Request">

          <div class="rsg-form-row">
            <div class="rsg-form-group">
              <label for="rsg-first-name">First Name *</label>
              <input type="text" id="rsg-first-name" name="contact[First Name]" required placeholder="Enter first name">
            </div>
            <div class="rsg-form-group">
              <label for="rsg-last-name">Last Name *</label>
              <input type="text" id="rsg-last-name" name="contact[Last Name]" required placeholder="Enter last name">
            </div>
          </div>

          <div class="rsg-form-row">
            <div class="rsg-form-group">
              <label for="rsg-email">Email Address *</label>
              <input type="email" id="rsg-email" name="contact[email]" required placeholder="name@example.com">
            </div>
            <div class="rsg-form-group">
              <label for="rsg-phone">Phone Number *</label>
              <input type="tel" id="rsg-phone" name="contact[phone]" required placeholder="+91 97233 28111">
            </div>
          </div>

          <div class="rsg-form-row">
            <div class="rsg-form-group rsg-form-group--full">
              <label for="rsg-address">Delivery Street Address *</label>
              <input type="text" id="rsg-address" name="contact[Street Address]" required placeholder="Flat / House No., Street, Area">
            </div>
          </div>

          <div class="rsg-form-row rsg-form-row--3col">
            <div class="rsg-form-group">
              <label for="rsg-city">City / Suburb *</label>
              <input type="text" id="rsg-city" name="contact[City]" required placeholder="City">
            </div>
            <div class="rsg-form-group">
              <label for="rsg-postcode">Postal Code *</label>
              <input type="text" id="rsg-postcode" name="contact[Postal Code]" required placeholder="Postal Code">
            </div>
            <div class="rsg-form-group">
              <label for="rsg-country">Country *</label>
              <input type="text" id="rsg-country" name="contact[Country]" value="India" required placeholder="Country">
            </div>
          </div>

          <div class="rsg-form-submit text-center">
            <button type="submit" class="rsg-btn rsg-btn--submit">SUBMIT REQUEST</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 9: SURPRISE PROPOSALS, RESIZING POLICY & EXPERT ADVICE
       ========================================================================= -->
  <section class="rsg-faq-section">
    <div class="rsg-container">
      <div class="rsg-faq-grid">
        
        <!-- CARD 1: SURPRISE PROPOSAL -->
        <div class="rsg-faq-card" data-aos="fade-up" data-aos-delay="100">
          <div class="rsg-faq-icon">💍</div>
          <h3 class="rsg-faq-title">Buying as a Surprise?</h3>
          <p class="rsg-faq-desc">
            Planning a surprise proposal? Choosing the correct ring size discreetly can feel challenging, but there are simple ways to get it right without spoiling the moment.
          </p>
          <ul class="rsg-faq-list">
            <li>Borrow a ring they already wear on the correct finger</li>
            <li>Ask a close friend or family member for guidance</li>
            <li>If unsure, choose a slightly larger size</li>
          </ul>
          <div class="rsg-tip-badge">
            <strong>Tip:</strong> A slightly larger ring is generally easier to resize than one that is too small.
          </div>
        </div>

        <!-- CARD 2: RESIZING POLICY -->
        <div class="rsg-faq-card" data-aos="fade-up" data-aos-delay="200">
          <div class="rsg-faq-icon">✨</div>
          <h3 class="rsg-faq-title">Resizing Policy</h3>
          <p class="rsg-faq-desc">
            We want you to feel 100% confident when purchasing your ring or custom fine jewellery. Our resizing policy gives you total peace of mind.
          </p>
          <ul class="rsg-faq-list">
            <li>Free resizing up to <strong>two sizes up or down</strong></li>
            <li>Easy support and consultation within 30 days of purchase</li>
            <li>Express insured shipping on all adjustments</li>
          </ul>
          <div class="rsg-tip-badge">
            <strong>Please note:</strong> Certain full eternity bands have resizing limitations depending on stone setting.
          </div>
        </div>

        <!-- CARD 3: EXPERT ASSISTANCE -->
        <div class="rsg-faq-card" data-aos="fade-up" data-aos-delay="300">
          <div class="rsg-faq-icon">📞</div>
          <h3 class="rsg-faq-title">Still Not Sure About Size?</h3>
          <p class="rsg-faq-desc">
            Ring sizing can feel confusing when shopping online. Our experienced gemologists and jewellery specialists are here to guide you every step of the way.
          </p>
          <div class="rsg-contact-box">
            <p><strong>HB Prestige Jewels</strong></p>
            <p>Email: <a href="mailto:hbprestigejewels@gmail.com">hbprestigejewels@gmail.com</a></p>
            <p>Phone / WhatsApp: <a href="tel:+919723328111">+91 97233 28111</a></p>
            <p>Mon - Sat : 10:00 AM - 7:00 PM</p>
          </div>
          <div class="rsg-btn-wrapper" style="margin-top: 15px;">
            <a href="/pages/contact" class="rsg-btn rsg-btn--outline">CONTACT OUR SPECIALISTS</a>
          </div>
        </div>

      </div>
    </div>
  </section>

</div>

<style>
/* ==========================================================================
   RING SIZE GUIDE STYLING (EXACT LUXURY EXPERIENCE)
   ========================================================================== */
.rsg-page-wrapper {
  width: 100%;
  background-color: #ffffff;
  color: #2b2b2b;
  overflow-x: hidden;
  font-family: var(--font-body-family, 'Work Sans', sans-serif);
}

.rsg-container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 24px;
}

.text-center { text-align: center; }

.rsg-subtag {
  display: inline-block;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: #c5897a; /* luxury rose gold / champagne accent */
  margin-bottom: 10px;
}

.rsg-section-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 32px;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.3;
  margin: 0 0 16px 0;
}

/* ==================== HEADER INTRO ==================== */
.rsg-header-section {
  padding: 50px 0 35px;
  text-align: center;
}

.rsg-header-box {
  max-width: 820px;
  margin: 0 auto;
}

.rsg-main-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 38px;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.25;
  margin: 0 0 18px;
}

.rsg-intro-text {
  font-size: 15px;
  line-height: 1.8;
  color: #555555;
  margin: 0;
}

/* ==================== SPLIT SECTIONS ==================== */
.rsg-split-section {
  padding: 45px 0;
  border-top: 1px solid #f2f2f2;
}

.rsg-split-section--alt {
  background-color: #faf9f7;
}

.rsg-split-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
}

.rsg-split-grid--reversed {
  direction: ltr;
}

.rsg-split-media {
  width: 100%;
}

.rsg-img-frame {
  width: 100%;
  border-radius: 6px;
  overflow: hidden;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
}

.rsg-img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.rsg-img-frame:hover .rsg-img {
  transform: scale(1.02);
}

.rsg-split-content {
  padding: 10px;
}

.rsg-desc {
  font-size: 14px;
  line-height: 1.75;
  color: #555555;
  margin: 0 0 16px 0;
}

.rsg-subheading {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 22px;
  font-weight: 500;
  color: #1a1a1a;
  margin: 24px 0 12px;
}

.rsg-bullet-list {
  margin: 0 0 20px 0;
  padding-left: 20px;
}

.rsg-bullet-list li {
  font-size: 14px;
  line-height: 1.7;
  color: #555555;
  margin-bottom: 8px;
}

.rsg-tip-box {
  background: #fdf8f5;
  border-left: 3px solid #c5897a;
  padding: 14px 18px;
  font-size: 13.5px;
  line-height: 1.65;
  color: #444444;
  border-radius: 0 4px 4px 0;
  margin-top: 18px;
}

/* ==================== DUAL IMAGES IN SPLIT ==================== */
.rsg-dual-img-wrap {
  position: relative;
  padding-bottom: 40px;
}

.rsg-img-frame--main {
  width: 85%;
}

.rsg-img-frame--sub {
  position: absolute;
  width: 50%;
  right: 0;
  bottom: 0;
  border: 4px solid #ffffff;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
}

/* ==================== CONVERSION TABLE SECTION ==================== */
.rsg-chart-section {
