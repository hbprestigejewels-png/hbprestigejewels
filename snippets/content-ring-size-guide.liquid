            <tr><td><strong>5.75</strong></td><td>AU L</td><td>—</td><td>11.25</td><td>16.31 mm & 51.20 mm</td></tr>
            <tr><td><strong>6</strong></td><td>AU L½</td><td>11</td><td>11.75</td><td>16.51 mm & 51.90 mm</td></tr>
            <tr><td><strong>6.25</strong></td><td>AU M</td><td>12</td><td>12.5</td><td>16.71 mm & 52.50 mm</td></tr>
            <tr><td><strong>6.5</strong></td><td>AU M½</td><td>13</td><td>13.25</td><td>16.92 mm & 53.10 mm</td></tr>
            <tr><td><strong>6.75</strong></td><td>AU N</td><td>—</td><td>13.75</td><td>17.12 mm & 53.80 mm</td></tr>
            <tr><td><strong>7</strong></td><td>AU N½</td><td>14</td><td>14.5</td><td>17.32 mm & 54.40 mm</td></tr>
            <tr><td><strong>7.25</strong></td><td>AU O</td><td>—</td><td>15</td><td>17.53 mm & 55.10 mm</td></tr>
