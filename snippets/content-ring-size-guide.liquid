          <tr><td>6</td><td>L</td><td>52</td><td>16.5 mm</td><td>51.9 mm</td></tr>
          <tr><td>6.5</td><td>M</td><td>53</td><td>16.9 mm</td><td>53.1 mm</td></tr>
          <tr><td>7</td><td>N</td><td>54</td><td>17.3 mm</td><td>54.4 mm</td></tr>
          <tr><td>7.5</td><td>O</td><td>56</td><td>17.7 mm</td><td>55.7 mm</td></tr>
          <tr><td>8</td><td>P</td><td>57</td><td>18.1 mm</td><td>57.0 mm</td></tr>
          <tr><td>8.5</td><td>Q</td><td>58</td><td>18.5 mm</td><td>58.3 mm</td></tr>
          <tr><td>9</td><td>R</td><td>60</td><td>19.0 mm</td><td>59.5 mm</td></tr>
