            <tr><td><strong>8.75</strong></td><td>AU R</td><td>—</td><td>19</td><td>18.75 mm & 58.90 mm</td></tr>
            <tr><td><strong>9</strong></td><td>AU R½</td><td>18</td><td>19.5</td><td>18.95 mm & 59.50 mm</td></tr>
            <tr><td><strong>9.25</strong></td><td>AU S</td><td>—</td><td>20.25</td><td>19.15 mm & 60.20 mm</td></tr>
            <tr><td><strong>9.5</strong></td><td>AU S½</td><td>19</td><td>20.75</td><td>19.35 mm & 60.80 mm</td></tr>
            <tr><td><strong>9.75</strong></td><td>AU T</td><td>—</td><td>21.5</td><td>19.56 mm & 61.40 mm</td></tr>
