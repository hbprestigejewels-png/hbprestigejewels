{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-hero-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background: {{ block.settings.background_gradient }};
    background-color: {{ block.settings.background_color }};
    text-align: center;
  }

  .ai-blog-hero__container-{{ ai_gen_id }} {
    max-width: 1000px;
    margin: 0 auto;
  }

  .ai-blog-hero__welcome-{{ ai_gen_id }} {
    font-size: {{ block.settings.welcome_size }}px;
    color: {{ block.settings.welcome_color }};
    margin: 0 0 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .ai-blog-hero__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 20px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-blog-hero__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0 0 40px;
    line-height: 1.6;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-blog-hero__search-wrapper-{{ ai_gen_id }} {
    max-width: 600px;
    margin: 0 auto 30px;
    position: relative;
  }

  .ai-blog-hero__search-form-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    align-items: stretch;
  }

  .ai-blog-hero__search-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 16px 20px;
    border: 2px solid {{ block.settings.search_border_color }};
    border-radius: {{ block.settings.search_border_radius }}px;
    font-size: 16px;
    background-color: {{ block.settings.search_bg_color }};
    color: {{ block.settings.search_text_color }};
    transition: all 0.3s ease;
  }

  .ai-blog-hero__search-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.search_focus_color }};
    box-shadow: 0 0 0 3px {{ block.settings.search_focus_color | color_modify: 'alpha', 0.2 }};
  }

  .ai-blog-hero__search-button-{{ ai_gen_id }} {
    padding: 16px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .ai-blog-hero__search-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
    box-shadow: 0 4px 12px {{ block.settings.button_bg_color | color_modify: 'alpha', 0.3 }};
  }

  .ai-blog-hero__features-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
    margin-top: 40px;
  }

  .ai-blog-hero__feature-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    background-color: {{ block.settings.feature_bg_color }};
    border-radius: {{ block.settings.feature_border_radius }}px;
    transition: all 0.3s ease;
  }

  .ai-blog-hero__feature-{{ ai_gen_id }}:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px {{ block.settings.feature_bg_color | color_modify: 'alpha', 0.3 }};
  }

  .ai-blog-hero__feature-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    color: {{ block.settings.feature_icon_color }};
  }

  .ai-blog-hero__feature-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.feature_text_color }};
    font-weight: 500;
  }

  .ai-blog-hero__divider-{{ ai_gen_id }} {
    width: 80px;
    height: 3px;
    background: {{ block.settings.divider_color }};
    margin: 30px auto;
    border-radius: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-blog-hero__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-blog-hero__welcome-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.welcome_size }}px * 0.8);
    }

    .ai-blog-hero__description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }

    .ai-blog-hero__search-form-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-blog-hero__search-button-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-blog-hero__features-{{ ai_gen_id }} {
      gap: 15px;
    }

    .ai-blog-hero__feature-{{ ai_gen_id }} {
      padding: 10px 16px;
    }
  }
{% endstyle %}

<blog-hero-{{ ai_gen_id }} class="ai-blog-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-hero__container-{{ ai_gen_id }}">
    {% if block.settings.show_welcome %}
      <div class="ai-blog-hero__welcome-{{ ai_gen_id }}">
        {{ block.settings.welcome_text }}
      </div>
    {% endif %}

    {% if block.settings.title != blank %}
      <h1 class="ai-blog-hero__title-{{ ai_gen_id }}">
        {{ block.settings.title }}
      </h1>
    {% endif %}

    {% if block.settings.show_divider %}
      <div class="ai-blog-hero__divider-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-blog-hero__description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    {% endif %}

    {% if block.settings.show_search %}
      <div class="ai-blog-hero__search-wrapper-{{ ai_gen_id }}">
        <form
          action="{{ routes.search_url }}"
          method="get"
          class="ai-blog-hero__search-form-{{ ai_gen_id }}"
          role="search"
        >
          <input
            type="search"
            name="q"
            class="ai-blog-hero__search-input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.search_placeholder }}"
            aria-label="Search blog articles"
            value="{{ search.terms | escape }}"
          >
          <input type="hidden" name="type" value="article">
          {% if block.settings.blog_handle != blank %}
            <input type="hidden" name="options[prefix]" value="last">
          {% endif %}
          <button type="submit" class="ai-blog-hero__search-button-{{ ai_gen_id }}">
            {{ block.settings.search_button_text }}
          </button>
        </form>
      </div>
    {% endif %}

    {% if block.settings.show_features %}
      <div class="ai-blog-hero__features-{{ ai_gen_id }}">
        {% if block.settings.feature_1_text != blank %}
          <div class="ai-blog-hero__feature-{{ ai_gen_id }}">
            <svg class="ai-blog-hero__feature-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="ai-blog-hero__feature-text-{{ ai_gen_id }}">{{ block.settings.feature_1_text }}</span>
          </div>
        {% endif %}

        {% if block.settings.feature_2_text != blank %}
          <div class="ai-blog-hero__feature-{{ ai_gen_id }}">
            <svg class="ai-blog-hero__feature-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="ai-blog-hero__feature-text-{{ ai_gen_id }}">{{ block.settings.feature_2_text }}</span>
          </div>
        {% endif %}

        {% if block.settings.feature_3_text != blank %}
          <div class="ai-blog-hero__feature-{{ ai_gen_id }}">
            <svg class="ai-blog-hero__feature-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span class="ai-blog-hero__feature-text-{{ ai_gen_id }}">{{ block.settings.feature_3_text }}</span>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</blog-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class BlogHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.searchForm = this.querySelector('.ai-blog-hero__search-form-{{ ai_gen_id }}');
        this.searchInput = this.querySelector('.ai-blog-hero__search-input-{{ ai_gen_id }}');
        
        if (this.searchForm && this.searchInput) {
          this.searchForm.addEventListener('submit', this.handleSearch.bind(this));
        }
      }

      handleSearch(event) {
        if (this.searchInput.value.trim() === '') {
          event.preventDefault();
          this.searchInput.focus();
        }
      }
    }

    customElements.define('blog-hero-{{ ai_gen_id }}', BlogHero{{ ai_gen_id }});
  })();
</script>

