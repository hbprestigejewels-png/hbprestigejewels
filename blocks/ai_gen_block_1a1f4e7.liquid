{% doc %}
  @prompt
    Create a premium styled blog posts section for a luxury jewelry brand. Each blog card should display: a full-width featured image with hover zoom effect, category/tag badge overlay on the image, article title in elegant serif font, excerpt/description text, author name with avatar, publish date, and a "Read More" button with a subtle underline animation. Cards should have a clean white background with soft shadow, rounded corners, and smooth hover lift effect. Layout should be a responsive 3-column grid on desktop, 2-column on tablet, 1-column on mobile. Include a section heading and optional subheading. Overall aesthetic should be editorial, minimal, and premium — matching a high-end jewelry brand.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-posts-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-blog-posts-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-blog-posts-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-blog-posts-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .ai-blog-posts-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-blog-posts-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
  }

  .ai-blog-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ai-blog-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.card_hover_lift }}px);
    box-shadow: 0 {{ block.settings.card_shadow_vertical | plus: 8 }}px {{ block.settings.card_shadow_blur | plus: 10 }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | times: 1.5 }});
  }

  .ai-blog-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
  }

  .ai-blog-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-blog-card-{{ ai_gen_id }}:hover .ai-blog-card-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-blog-card-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 14px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 2;
  }

  .ai-blog-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .ai-blog-card-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-style: {{ block.settings.title_font.style }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    line-height: 1.3;
    text-decoration: none;
    display: block;
  }

  .ai-blog-card-title-{{ ai_gen_id }}:hover {
    color: {{ block.settings.title_hover_color }};
  }

  .ai-blog-card-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    color: {{ block.settings.excerpt_color }};
    line-height: 1.6;
    margin: 0 0 20px;
    flex-grow: 1;
  }

  .ai-blog-card-meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-blog-card-author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-blog-card-avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    object-fit: cover;
    background-color: {{ block.settings.avatar_placeholder_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.avatar_size | divided_by: 2 }}px;
    color: {{ block.settings.avatar_placeholder_text }};
    font-weight: 600;
  }

  .ai-blog-card-author-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.meta_font_size }}px;
    color: {{ block.settings.meta_color }};
    font-weight: 500;
  }

  .ai-blog-card-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.meta_font_size }}px;
    color: {{ block.settings.meta_color }};
  }

  .ai-blog-card-button-{{ ai_gen_id }} {
    display: inline-block;
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    text-decoration: none;
    position: relative;
    padding-bottom: 4px;
    transition: color 0.3s ease;
  }

  .ai-blog-card-button-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background-color: {{ block.settings.button_underline_color }};
    transition: width 0.3s ease;
  }

  .ai-blog-card-button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.button_hover_color }};
  }

  .ai-blog-card-button-{{ ai_gen_id }}:hover::after {
    width: 100%;
  }

  .ai-blog-card-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-blog-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-blog-posts-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-blog-posts-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-blog-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-blog-posts-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-blog-posts-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-blog-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-blog-posts-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 0 {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }
  }
{% endstyle %}

<blog-posts-{{ ai_gen_id }} class="ai-blog-posts-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-posts-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-blog-posts-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-blog-posts-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-blog-posts-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-blog-posts-grid-{{ ai_gen_id }}">
      {% if block.settings.blog != blank %}
        {% for article in block.settings.blog.articles limit: block.settings.posts_to_show %}
          <article class="ai-blog-card-{{ ai_gen_id }}">
            <div class="ai-blog-card-image-wrapper-{{ ai_gen_id }}">
              {% if article.image %}
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.image.alt | escape }}"
                  class="ai-blog-card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="{{ 800 | divided_by: article.image.aspect_ratio | round }}"
                >
              {% else %}
                <div class="ai-blog-card-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if block.settings.show_badge and article.tags.size > 0 %}
                <div class="ai-blog-card-badge-{{ ai_gen_id }}">
                  {{ article.tags.first }}
                </div>
              {% endif %}
            </div>

            <div class="ai-blog-card-content-{{ ai_gen_id }}">
              <a href="{{ article.url }}" class="ai-blog-card-title-{{ ai_gen_id }}">
                {{ article.title }}
              </a>

              {% if block.settings.show_excerpt and article.excerpt != blank %}
                <div class="ai-blog-card-excerpt-{{ ai_gen_id }}">
                  {{ article.excerpt | strip_html | truncate: block.settings.excerpt_length }}
                </div>
              {% endif %}

              <div class="ai-blog-card-meta-{{ ai_gen_id }}">
                {% if block.settings.show_author %}
                  <div class="ai-blog-card-author-{{ ai_gen_id }}">
                    {% if block.settings.author_avatar %}
                      <img
                        src="{{ block.settings.author_avatar | image_url: width: 100 }}"
                        alt="{{ article.author }}"
                        class="ai-blog-card-avatar-{{ ai_gen_id }}"
                        loading="lazy"
                        width="100"
                        height="100"
                      >
                    {% else %}
                      <div class="ai-blog-card-avatar-{{ ai_gen_id }}">
                        {{ article.author | slice: 0 | upcase }}
                      </div>
                    {% endif %}
                    <span class="ai-blog-card-author-name-{{ ai_gen_id }}">{{ article.author }}</span>
                  </div>
                {% endif %}

                {% if block.settings.show_date %}
                  <time class="ai-blog-card-date-{{ ai_gen_id }}" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                    {{ article.published_at | date: block.settings.date_format }}
                  </time>
                {% endif %}
              </div>

              <a href="{{ article.url }}" class="ai-blog-card-button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            </div>
          </article>
        {% endfor %}
      {% else %}
        {% for i in (1..block.settings.posts_to_show) %}
          <article class="ai-blog-card-{{ ai_gen_id }}">
            <div class="ai-blog-card-image-wrapper-{{ ai_gen_id }}">
              <div class="ai-blog-card-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
              {% if block.settings.show_badge %}
                <div class="ai-blog-card-badge-{{ ai_gen_id }}">Category</div>
              {% endif %}
            </div>

            <div class="ai-blog-card-content-{{ ai_gen_id }}">
              <a href="#" class="ai-blog-card-title-{{ ai_gen_id }}">
                Article Title
              </a>

              {% if block.settings.show_excerpt %}
                <div class="ai-blog-card-excerpt-{{ ai_gen_id }}">
                  This is a sample excerpt for your blog post. Select a blog to display your actual articles.
                </div>
              {% endif %}

              <div class="ai-blog-card-meta-{{ ai_gen_id }}">
                {% if block.settings.show_author %}
                  <div class="ai-blog-card-author-{{ ai_gen_id }}">
                    <div class="ai-blog-card-avatar-{{ ai_gen_id }}">A</div>
                    <span class="ai-blog-card-author-name-{{ ai_gen_id }}">Author Name</span>
                  </div>
                {% endif %}

                {% if block.settings.show_date %}
                  <time class="ai-blog-card-date-{{ ai_gen_id }}">
                    {{ 'now' | date: block.settings.date_format }}
                  </time>
                {% endif %}
              </div>

              <a href="#" class="ai-blog-card-button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</blog-posts-{{ ai_gen_id }}>

<script>
  (function() {
    class BlogPosts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('blog-posts-{{ ai_gen_id }}', BlogPosts{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Premium blog posts",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Posts to show",
      "default": 6
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Latest Stories"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our curated collection of insights and inspiration"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
